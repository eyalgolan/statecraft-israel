<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Statecraft.uss" />
    <!-- "loading" until GameRoot has started the game: only the loading line shows (playtest 2, P2-1). -->
    <ui:VisualElement name="root" class="root loading" picking-mode="Ignore">
        <ui:Label name="loading" text="Loading the map of 1948…" class="loading-line" picking-mode="Ignore" />
        <!-- Settlement names, positioned by MapLabelsPresenter under every panel; clicks pass through to the map. -->
        <ui:VisualElement name="map-labels" class="map-labels" picking-mode="Ignore" />
        <!-- HUD round 2, part 2 (#398): promo 03's left icon column, the four screens (ScreenNav), icon-only; each one's name
             is its text (the event log records it), hidden, and its tooltip, shown beside it on hover and on focus
             (HoverTip). Before the top bar in the tree, so Tab still runs Cabinet, Budget, Defence, Why?, New Game, End Turn. -->
        <!-- The left column's strip of the decision card's backdrop (review of #602): dimmed and taking the pointer while the
             card is open (event-modal), so the map is blocked between and below the discs as it is everywhere else; before
             the column in the tree, so the column's buttons stay above it and usable. -->
        <ui:VisualElement name="event-gutter" class="event-gutter" />
        <ui:VisualElement name="left-column" class="left-column" picking-mode="Ignore">
            <ui:Button name="nav-cabinet" text="Cabinet" class="nav-button rail-button"><Statecraft.Game.UI.UiIcon glyph="columns" class="nav-disc" /></ui:Button>
            <ui:Button name="nav-budget" text="Budget" class="nav-button rail-button"><Statecraft.Game.UI.UiIcon glyph="ledger" class="nav-disc" /></ui:Button>
            <ui:Button name="nav-defence" text="Defence" class="nav-button rail-button"><Statecraft.Game.UI.UiIcon glyph="helmet" class="nav-disc" /></ui:Button>
            <ui:Button name="nav-why" text="Why?" class="nav-button rail-button"><Statecraft.Game.UI.UiIcon glyph="question" class="nav-disc" /></ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="top-bar" class="panel top-bar">
            <Statecraft.Game.UI.UiFrame corners="false" rule="false" />
            <ui:VisualElement name="date-plate" class="date-box">
                <ui:VisualElement class="year-row">
                    <ui:Label name="year" class="year" />
                    <ui:Label name="score" class="muted" />
                </ui:VisualElement>
                <ui:VisualElement class="date-row">
                    <ui:Label name="turn" class="muted" />
                    <ui:Label name="date" class="muted" />
                </ui:VisualElement>
                <Statecraft.Game.UI.UiFrame shadow="false" filigree="true" />
            </ui:VisualElement>
            <!-- Meter captions are the content display names as written, in sentence case (#622) (Money and
                 Foreign currency: model.yaml money; Security and International support: model.yaml indicators;
                 HudTests.TopBarCaptionsAreTheContentNames). Immigration and Public support are UI quantities. -->
            <ui:VisualElement name="meters" class="meters">
                <ui:VisualElement name="meter-treasury" class="meter">
                    <Statecraft.Game.UI.UiIcon glyph="coin" class="meter-icon" />
                    <ui:VisualElement class="meter-body">
                        <ui:Label text="Money" class="meter-name" />
                        <ui:VisualElement class="meter-row"><ui:Label name="treasury-value" class="meter-value" /><ui:Label name="treasury-delta" class="meter-delta" /></ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="meter-immigration" class="meter">
                    <Statecraft.Game.UI.UiIcon glyph="people" class="meter-icon" />
                    <ui:VisualElement class="meter-body">
                        <ui:Label text="Immigration" class="meter-name" />
                        <ui:VisualElement class="meter-row"><ui:Label name="immigration-value" class="meter-value" /><ui:Label name="immigration-delta" class="meter-delta" /></ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="meter-security" class="meter">
                    <Statecraft.Game.UI.UiIcon glyph="shield" class="meter-icon" />
                    <ui:VisualElement class="meter-body">
                        <!-- The level beside the caption (HUD round 2, part 3): the bar keeps two lines, as promo 03's meters do. -->
                        <ui:VisualElement class="meter-caption-row"><ui:Label text="Security" class="meter-name" /><ui:Label name="security-level" class="meter-name" /></ui:VisualElement>
                        <ui:VisualElement class="meter-row"><ui:Label name="security-value" class="meter-value" /><ui:Label name="security-delta" class="meter-delta" /></ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="meter-support" class="meter">
                    <Statecraft.Game.UI.UiIcon glyph="crowd" class="meter-icon" />
                    <ui:VisualElement class="meter-body">
                        <ui:Label text="Public support" class="meter-name" />
                        <ui:VisualElement class="meter-row"><ui:Label name="support-value" class="meter-value" /><ui:Label name="support-delta" class="meter-delta" /></ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="meter-standing" class="meter">
                    <Statecraft.Game.UI.UiIcon glyph="globe" class="meter-icon" />
                    <ui:VisualElement class="meter-body">
                        <ui:Label text="International support" class="meter-name" />
                        <ui:VisualElement class="meter-row"><ui:Label name="standing-value" class="meter-value" /><ui:Label name="standing-delta" class="meter-delta" /></ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="meter-fx" class="meter">
                    <Statecraft.Game.UI.UiIcon glyph="banknote" class="meter-icon" />
                    <ui:VisualElement class="meter-body">
                        <ui:Label text="Foreign currency" class="meter-name" />
                        <ui:VisualElement class="meter-row"><ui:Label name="fx-value" class="meter-value" /><ui:Label name="fx-delta" class="meter-delta" /></ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="nav" class="nav">
                <ui:Button name="new-game" text="New game" class="nav-button bar-button"><Statecraft.Game.UI.UiIcon glyph="restart" class="nav-disc" /></ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="turn-box">
                <ui:Label name="attention" class="muted" />
                <ui:Button name="end-turn" text="End turn" class="end-turn" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- The right-hand column: the minimap, with the border layer's caption beside it. -->
        <ui:VisualElement name="right-column" class="right-column" picking-mode="Ignore">
            <ui:VisualElement class="right-gap" picking-mode="Ignore" />
            <!-- What the map's region borders show while they are drawn (owner ruling 2026-10-11: "Mandate sub-districts, 1947"). -->
            <ui:Label name="map-layer" class="map-layer" picking-mode="Ignore" />
            <!-- The painted relief picture (a bake: tools/minimap_bake.py) and, beside it, promo 03's three round buttons:
                 the whole map, the settlement names, the region borders (MinimapPresenter). The picture takes no focus (the
                 accessibility audit's B1d); the buttons do, after End Turn. -->
            <ui:VisualElement name="minimap" class="panel minimap">
                <ui:VisualElement name="minimap-map" class="minimap-map" picking-mode="Ignore">
                    <ui:VisualElement name="minimap-image" class="minimap-image">
                        <ui:VisualElement name="minimap-view" class="minimap-view" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="minimap-buttons" class="minimap-buttons" picking-mode="Ignore">
                    <ui:Button name="minimap-overview" class="minimap-button"><Statecraft.Game.UI.UiIcon glyph="peaks" class="minimap-disc" picking-mode="Ignore" /></ui:Button>
                    <ui:Button name="minimap-labels" class="minimap-button"><Statecraft.Game.UI.UiIcon glyph="skyline" class="minimap-disc" picking-mode="Ignore" /></ui:Button>
                    <ui:Button name="minimap-borders" class="minimap-button"><Statecraft.Game.UI.UiIcon glyph="region" class="minimap-disc" picking-mode="Ignore" /></ui:Button>
                </ui:VisualElement>
                <Statecraft.Game.UI.UiFrame filigree="true" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="info-panel" class="panel info-panel">
            <!-- The selected hex's terrain sign on its map colour, beside its real facts (no tile yields: owner ruling). -->
            <Statecraft.Game.UI.UiIcon name="info-thumb" class="info-thumb" />
            <ui:VisualElement class="info-body">
                <ui:Label name="info-title" class="title" />
                <ui:Label name="info-subtitle" class="muted" />
                <ui:VisualElement class="gold-rule" />
                <!-- The hex's facts as the promo's icon rows (HUD round 1, #398): a sign, then the line, which wraps (#397).
                     InfoPanelPresenter hides a row with nothing to say. Only what the game models: no yields, no land-use name. -->
                <ui:VisualElement class="info-row"><Statecraft.Game.UI.UiIcon glyph="region" class="info-row-sign" /><ui:Label name="info-region" class="muted wrap info-row-text" /></ui:VisualElement>
                <ui:VisualElement class="info-row"><Statecraft.Game.UI.UiIcon glyph="house" class="info-row-sign" /><ui:Label name="info-settlements" class="wrap info-row-text" /></ui:VisualElement>
                <ui:VisualElement class="info-row"><Statecraft.Game.UI.UiIcon glyph="village" class="info-row-sign" /><ui:Label name="info-localities" class="muted wrap info-row-text" /></ui:VisualElement>
                <ui:VisualElement class="info-row"><Statecraft.Game.UI.UiIcon glyph="flag" class="info-row-sign" /><ui:Label name="info-placement" class="muted wrap info-row-text" /></ui:VisualElement>
                <ui:VisualElement class="row">
                    <ui:Button name="build-camp" />
                    <ui:Button name="build-housing" />
                    <ui:Button name="info-defence" />
                </ui:VisualElement>
                <ui:Label name="info-reason" class="reason" />
            </ui:VisualElement>
            <Statecraft.Game.UI.UiFrame filigree="true" />
        </ui:VisualElement>
        <!-- The decision layer under the top bar (decision cards, 2026-10-13): while an event is open a dim backdrop blocks the
             map and the panels under it, and the card sits in the middle, up to 1040 px wide, with a 16:9 media header (the
             event's photograph). Hidden under the start screen and any open screen (ScreenNav.DisableCovered). -->
        <ui:VisualElement name="event-layer" class="event-layer" picking-mode="Ignore">
            <ui:VisualElement name="event-scrim" class="event-scrim" />
            <!-- The backdrop's band from the bar's bottom to the column's top, the window's full width: it dims the hanging date
                 plate evenly and leaves no live strip of map (review of #624). Above the left column's top, so it never
                 covers a disc. -->
            <ui:VisualElement name="event-scrim-top" class="event-scrim-top" />
            <ui:VisualElement name="event-card" class="panel event-card">
                <!-- The 16:9 media header: an archival photograph of the event (EventImageCatalog), framed in gold, with its
                     credit line as a caption strip along its bottom edge, and, for an event with a clip, the Illustration
                     switch in its top corner (a silent AI-generated loop, labelled so in place of the credit). Events without
                     a photograph show the minister's portrait in the head instead. -->
                <ui:VisualElement name="event-photo" class="event-photo"><ui:Label name="event-photo-credit" class="event-photo-credit" /></ui:VisualElement>
                <!-- A portrait-shaped thumbnail beside the heading, framed on the face (playtest 2, P2-3 and P2-5). -->
                <ui:VisualElement class="event-head">
                    <ui:VisualElement name="event-image" class="event-image" />
                    <ui:VisualElement class="event-heading">
                        <ui:Label name="event-draft" text="DRAFT" class="draft" />
                        <ui:Label name="event-title" class="title event-title" />
                        <ui:Label name="event-office" class="muted event-office" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="gold-rule" />
                <ui:ScrollView name="event-scroll" class="event-scroll"><ui:Label name="event-text" class="event-text" /></ui:ScrollView>
                <ui:VisualElement name="event-options" />
                <!-- The count of other open decisions, and Hide: the card collapses to "Decision waiting" so the map can be
                     inspected (EventCardPresenter.Collapse); focus order: the options, then Hide. -->
                <ui:VisualElement name="event-foot" class="event-foot">
                    <ui:Label name="event-count" class="muted event-count" />
                    <ui:Button name="event-hide" class="event-hide" />
                </ui:VisualElement>
                <!-- The Illustration switch, drawn over the media header's top right corner, last in the card so Tab reaches it
                     after the options and Hide (#41). -->
                <ui:Button name="event-illustration" class="event-illustration" />
                <Statecraft.Game.UI.UiFrame filigree="true" />
            </ui:VisualElement>
            <ui:Button name="event-reopen" class="event-reopen" />
        </ui:VisualElement>
        <!-- The Cabinet as promo/final/04 (CabinetPresenter): a wide screen; the Prime Minister's card and the appointment
             list at the side; the legislature's seats (Hemicycle) with its legend above a grid of person cards. -->
        <ui:VisualElement name="screen-cabinet" class="panel screen screen-wide">
            <ui:VisualElement class="screen-header"><ui:Label name="cabinet-government" class="title" /><ui:Label name="cabinet-legislature" class="muted" /></ui:VisualElement>
            <ui:VisualElement name="cabinet-body" class="row grow">
                <ui:VisualElement name="cabinet-side" class="cabinet-side">
                    <ui:Button name="seat-prime_minister" class="seat pm-card" />
                    <!-- The other offices the PM holds: listed on the card, selectable here (CabinetPresenter). -->
                    <ui:VisualElement name="cabinet-pm-offices" class="pm-offices" />
                    <ui:VisualElement name="cabinet-pick" class="grow">
                        <ui:Label name="cabinet-pick-title" class="meter-name" />
                        <ui:Label name="cabinet-pick-reason" class="reason" />
                        <ui:ScrollView name="cabinet-candidates" class="grow" />
                    </ui:VisualElement>
                    <ui:Label name="cabinet-status" class="muted" />
                </ui:VisualElement>
                <ui:VisualElement name="cabinet-main" class="cabinet-main grow">
                    <ui:VisualElement name="cabinet-house" class="cabinet-house">
                        <ui:VisualElement class="hemicycle-box">
                            <Statecraft.Game.UI.Hemicycle name="cabinet-hemicycle" class="hemicycle" />
                            <ui:VisualElement class="hemicycle-count" picking-mode="Ignore">
                                <ui:Label name="cabinet-house-size" class="house-size" />
                                <ui:Label name="cabinet-house-unit" class="house-unit" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="house-legend">
                            <ui:Label name="cabinet-coalition" class="house-coalition" />
                            <Statecraft.Game.UI.UiBar name="cabinet-stability" class="ui-bar--stability house-stability" />
                            <ui:Label name="cabinet-opposition" class="muted" />
                            <ui:Label name="cabinet-majority" class="muted" />
                            <ui:Label name="cabinet-largest" class="muted" />
                            <ui:VisualElement name="cabinet-parties" class="party-chips" />
                        </ui:VisualElement>
                        <Statecraft.Game.UI.UiFrame shadow="false" corners="false" />
                    </ui:VisualElement>
                    <ui:ScrollView name="cabinet-seats" class="grow" />
                </ui:VisualElement>
            </ui:VisualElement>
            <Statecraft.Game.UI.UiFrame />
        </ui:VisualElement>
        <ui:VisualElement name="screen-budget" class="panel screen">
            <ui:VisualElement class="screen-header"><ui:Label name="budget-screen-title" text="Budget" class="title" /><ui:Label name="budget-vote" class="muted" /></ui:VisualElement>
            <ui:Label name="budget-money" />
            <ui:Label name="budget-flow" class="muted" />
            <ui:ScrollView name="budget-rows" class="grow" />
            <ui:VisualElement class="row">
                <ui:Button name="budget-reset" text="Reset" />
                <ui:Button name="budget-submit" text="Submit the budget" />
                <ui:Label name="budget-status" class="muted grow" />
            </ui:VisualElement>
            <Statecraft.Game.UI.UiFrame />
        </ui:VisualElement>
        <!-- Defence as promo/final/08 (DefencePresenter): leadership, the escalation ladder and the reserve call-up side by
             side (wrapping in a narrow window), then the defence share of the budget. Only what the sim models. -->
        <ui:VisualElement name="screen-defence" class="panel screen screen-wide">
            <ui:VisualElement class="screen-header"><ui:Label name="defence-screen-title" text="Defence" class="title" /><ui:Label name="defence-command" class="muted" /></ui:VisualElement>
            <ui:ScrollView name="defence-body" class="grow">
                <ui:VisualElement class="defence-row">
                    <ui:VisualElement name="defence-leadership" class="defence-panel defence-leadership">
                        <ui:Label name="defence-title-leadership" class="section-title" />
                        <ui:VisualElement class="leaders">
                            <ui:VisualElement name="lead-prime_minister" class="leader" />
                            <ui:VisualElement name="lead-defense_minister" class="leader" />
                            <ui:VisualElement name="lead-chief_of_staff" class="leader" />
                        </ui:VisualElement>
                        <Statecraft.Game.UI.UiFrame shadow="false" />
                    </ui:VisualElement>
                    <ui:VisualElement name="defence-ladder" class="defence-panel defence-ladder">
                        <ui:Label name="defence-title-ladder" class="section-title" />
                        <ui:VisualElement name="ladder">
                            <ui:VisualElement name="rung-5" class="rung"><ui:Label name="rung-5-name" class="grow rung-name" /><ui:Label name="rung-5-turn" class="muted rung-turn" /></ui:VisualElement>
                            <ui:VisualElement name="rung-4" class="rung"><ui:Label name="rung-4-name" class="grow rung-name" /><ui:Label name="rung-4-turn" class="muted rung-turn" /></ui:VisualElement>
                            <ui:VisualElement name="rung-3" class="rung"><ui:Label name="rung-3-name" class="grow rung-name" /><ui:Label name="rung-3-turn" class="muted rung-turn" /></ui:VisualElement>
                            <ui:VisualElement name="rung-2" class="rung"><ui:Label name="rung-2-name" class="grow rung-name" /><ui:Label name="rung-2-turn" class="muted rung-turn" /></ui:VisualElement>
                            <ui:VisualElement name="rung-1" class="rung"><ui:Label name="rung-1-name" class="grow rung-name" /><ui:Label name="rung-1-turn" class="muted rung-turn" /></ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label name="ceasefire" class="muted wrap" />
                        <ui:VisualElement class="row">
                            <ui:Button name="de-escalate" text="Lower the level" />
                            <ui:Button name="escalate" text="Raise the level" />
                        </ui:VisualElement>
                        <ui:Label name="order-pending" class="muted" />
                        <Statecraft.Game.UI.UiFrame shadow="false" />
                    </ui:VisualElement>
                    <ui:VisualElement name="defence-callup" class="defence-panel defence-callup">
                        <ui:Label name="defence-title-callup" class="section-title" />
                        <ui:Label name="mob-percent" class="big-figure" />
                        <Statecraft.Game.UI.UiBar name="mob-bar" class="ui-bar--mobilization big-bar" />
                        <ui:Label name="mob-level" class="wrap" />
                        <ui:VisualElement class="row">
                            <ui:Button name="mob-down" text="-5%" />
                            <ui:Button name="mob-up" text="+5%" />
                        </ui:VisualElement>
                        <ui:Label name="mob-cost" class="muted wrap" />
                        <Statecraft.Game.UI.UiFrame shadow="false" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="defence-budget" class="defence-panel defence-budget">
                    <ui:Label name="defence-title-budget" class="section-title budget-title" />
                    <Statecraft.Game.UI.UiBar name="defence-budget-bar" class="ui-bar--budget big-bar grow" />
                    <ui:Label name="defence-budget-share" class="budget-share" />
                    <Statecraft.Game.UI.UiFrame shadow="false" />
                </ui:VisualElement>
            </ui:ScrollView>
            <Statecraft.Game.UI.UiFrame />
        </ui:VisualElement>
        <ui:VisualElement name="screen-why" class="panel screen">
            <ui:VisualElement class="screen-header"><ui:Label name="why-screen-title" text="Why did this happen?" class="title" /><ui:Label name="why-turn" class="muted" /></ui:VisualElement>
            <ui:ScrollView name="why-rows" class="grow" />
            <Statecraft.Game.UI.UiFrame />
        </ui:VisualElement>
        <!-- The End Turn outcome clip (OutcomePresenter): the historical order the player gave, as a 3.5 s silent clip in the
             middle, captioned as the order; a click, Enter or Space skips it, Esc skips them all. After the screens, so it
             is drawn over them (an open screen is also closed when a clip starts); only the start screen and the toast come
             later. -->
        <ui:VisualElement name="outcome-layer" class="outcome-layer">
            <ui:VisualElement name="outcome-frame" class="panel outcome-frame" picking-mode="Ignore">
                <ui:VisualElement name="outcome-media" class="outcome-media" picking-mode="Ignore"><ui:Label name="outcome-label" class="outcome-label" picking-mode="Ignore" /></ui:VisualElement>
                <ui:Label name="outcome-caption" class="title outcome-caption" picking-mode="Ignore" />
                <ui:Label name="outcome-hint" class="muted outcome-hint" picking-mode="Ignore" />
                <Statecraft.Game.UI.UiFrame filigree="true" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- The start screen (StartScreenPresenter): shown over the started game before its first turn (never in automated
             runs). The painting is AI-generated concept art (ASSETS.yaml), with no identifiable person. The two quotations
             are the Declaration of the Establishment of the State of Israel, word for word: the official Hebrew (Iton
             Rishmi No. 1, 14 May 1948) with the official English translation under each line; StartScreenTests checks them
             against docs/sources/declaration-1948. The Hebrew labels use the advanced text generator, which lays out
             right-to-left text (#193), with a right-to-left base direction (each line starts with a neutral ellipsis or ends with a full stop, which would otherwise take the left-to-right default). Drawn above the HUD and below the toast, which carries New Game's prompt. -->
        <ui:VisualElement name="start-screen" class="start-screen">
            <ui:VisualElement name="start-art" class="start-art" picking-mode="Ignore" />
            <ui:VisualElement name="start-body" class="start-body" picking-mode="Ignore">
                <ui:VisualElement name="start-panel" class="panel start-panel">
                    <ui:Label name="start-title" text="Statecraft: Israel" class="start-title" />
                    <ui:VisualElement class="gold-rule start-rule" />
                    <ui:Label name="start-he-proclamation" text="…אנו מכריזים בזאת על הקמת מדינה יהודית בארץ־ישראל, היא מדינת ישראל." class="start-he" language-direction="RTL" />
                    <ui:Label name="start-en-proclamation" text="…HEREBY DECLARE THE ESTABLISHMENT OF A JEWISH STATE IN ERETZ-ISRAEL, TO BE KNOWN AS THE STATE OF ISRAEL." class="start-en" />
                    <ui:Label name="start-he-date" text="בעיר תל־אביב, היום הזה, ערב שבת, ה׳ אייר תש״ח, 14 במאי 1948." class="start-he start-he-date" language-direction="RTL" />
                    <ui:Label name="start-en-date" text="IN THE CITY OF TEL-AVIV, ON THIS SABBATH EVE, THE 5TH DAY OF IYAR, 5708 (14TH MAY, 1948)." class="start-en" />
                    <ui:Label name="start-source" text="From the Declaration of the Establishment of the State of Israel (Official Gazette No. 1, 14 May 1948) and its official English translation. Painting: AI-generated." class="start-source" />
                    <!-- Ben-Gurion's reading of the proclaiming sentence, 14 May 1948, recorded by Ralph Hellinger of Radio Doctor, Israel
                         State Archives ISA-Collections-Recordings-00113hj (DeclarationRecording): it plays
                         only from this button, over the still painting, with its words as captions above the panel. -->
                    <ui:VisualElement name="start-recording" class="start-recording">
                        <ui:Button name="start-listen" class="start-listen" />
                        <ui:Label name="start-recording-credit" text="Recording: Ralph Hellinger, Israel State Archives" class="start-recording-credit" />
                    </ui:VisualElement>
                    <ui:VisualElement name="start-actions" class="start-actions">
                        <ui:Button name="start-continue" text="Continue" class="start-button" />
                        <ui:Button name="start-new-game" text="New game" class="start-button" />
                    </ui:VisualElement>
                    <ui:VisualElement name="start-caption" class="start-caption" picking-mode="Ignore">
                        <ui:Label name="start-caption-he" text="…אנו מכריזים בזאת על הקמת מדינה יהודית בארץ־ישראל, היא מדינת ישראל." class="start-he start-caption-he" language-direction="RTL" picking-mode="Ignore" />
                        <ui:Label name="start-caption-en" text="…HEREBY DECLARE THE ESTABLISHMENT OF A JEWISH STATE IN ERETZ-ISRAEL, TO BE KNOWN AS THE STATE OF ISRAEL." class="start-caption-en" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <Statecraft.Game.UI.UiFrame />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="toast" class="panel toast" />
        <!-- The name of an icon-only button, beside it on hover and on keyboard focus (HoverTip; UI Toolkit draws `tooltip`
             only in Editor UI). Last, so it draws over the panels; it takes no clicks. -->
        <ui:Label name="hud-tip" class="hud-tip" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
