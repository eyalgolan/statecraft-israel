/* Statecraft UI language, restyled to the promo's interface (promo/final/03-gameplay-1936.png, 05, 08): translucent navy
   panels with a thin gold border, an inset gold rule, corner brackets and a soft shadow (UiFrame), round gold-rimmed icon
   buttons (UiIcon), an icon per indicator in the top bar, and EB Garamond throughout. */
:root {
    --navy: rgba(13, 21, 37, 0.97);   /* blended in linear space: 0.97 still lets the map's light through faintly */
    --navy-deep: rgb(9, 14, 26);
    --navy-solid: rgb(14, 22, 38);   /* --navy without its transparency */
    --navy-raised: rgb(20, 31, 52);  /* the date badge and a hovered button */
    --gold: rgb(196, 160, 92);
    --gold-light: rgb(232, 204, 142);
    --gold-dim: rgba(196, 160, 92, 0.45);
    --ink: rgb(236, 228, 210);
    --ink-dim: rgb(170, 164, 150);
    --up: rgb(126, 196, 120);
    --down: rgb(222, 120, 104);
    --focus: rgb(120, 98, 58);       /* keyboard focus fill: >= 3:1 against --navy-deep (WCAG 2.4.13) */
    --focus-ink: rgb(255, 252, 244); /* text on the focus fill: 5.7:1 on it (ink is 4.6, gold-light 3.7; #41 M3) */
}

.root {
    flex-grow: 1;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/EBGaramond-Regular.ttf");
    color: var(--ink);
    font-size: 20px;
}

.panel {
    background-color: var(--navy);
    border-color: var(--gold-dim);
    border-width: 1px;
    border-radius: 3px;
    padding: 12px;
}

/* UiFrame: the trim overlay (drawn in code) fills its panel and is never laid out with the content. */
.ui-frame { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.title {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/EBGaramond-SemiBold.ttf");
    font-size: 30px;
    color: var(--ink);
}

.muted { color: var(--ink-dim); }
.delta-up { color: var(--up); }
.delta-down { color: var(--down); }
/* A thin gold rule under a heading (the promo's divider). */
.gold-rule { height: 1px; flex-shrink: 0; background-color: var(--gold-dim); margin: 4px 0 6px 0; }

.button, Button {
    background-color: var(--navy-deep);
    border-color: var(--gold-dim);
    border-width: 1px;
    border-radius: 4px;
    color: var(--ink);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/EBGaramond-Regular.ttf");
    font-size: 19px;
    padding: 6px 12px;
    margin: 3px 0;
    -unity-text-align: middle-left;
}
Button:hover { border-color: var(--gold); background-color: var(--navy-raised); }
/* Keyboard focus shows as a bright gold edge (navigation with Tab and the arrow keys). */
Button:focus { border-color: var(--gold-light); background-color: var(--focus); color: var(--focus-ink); }
Button:disabled { color: var(--ink-dim); border-color: rgba(120, 120, 120, 0.4); background-color: var(--navy-deep); }
/* A screen button stays transparent around its disc in every state. */
.nav-button:disabled, .nav-button:focus { background-color: rgba(0, 0, 0, 0); border-width: 0; }

/* Top bar: the date badge, the national indicators (icon, name, value and change), the round screen buttons, attention
   and End Turn. */
.top-bar {
    position: absolute; left: 0; right: 0; top: 0; height: 70px;
    flex-direction: row; align-items: center;
    border-width: 0 0 1px 0; border-radius: 0; padding: 0 14px 0 8px;
    border-color: rgba(196, 160, 92, 0.75);
    background-color: var(--navy-solid);   /* opaque: map labels must not show through it (Task 24 review M7) */
}
/* HUD round 2, part 3 (#398): the one-row bar is 70 px, 6.5% of a 16:9 frame, as promo 03's and T29's (T54: it was 96,
   8.8%). Everything in it fits two lines (EB Garamond lines are about 1.55 x the font size): labels lose their default
   vertical padding and margin; the date plate hangs below the bar, as promo 03's "1936 / Turn 1 / January 1936" does. */
.top-bar Label { padding-top: 0; padding-bottom: 0; margin-top: 0; margin-bottom: 0; }
/* The date badge: a raised, trimmed box at the left, as the promo's "1936 / Turn 1 / January 1936" plate. */
.date-box {
    /* A fixed width, wide enough for the widest line ("Turn 120  30 September 1956"), so the meters never shift when the
       month changes; at least 98 px tall, so it hangs 28 px below the 70 px bar as promo 03's plate does, and grows if the
       date wraps to a third line. */
    flex-shrink: 0; width: 230px; min-height: 98px; align-self: flex-start; justify-content: center;
    padding: 2px 10px 2px 12px; margin-right: 10px;
    background-color: var(--navy-raised); border-width: 1px; border-color: var(--gold-dim); border-radius: 2px;
}
/* Turn and date share a line; if they do not fit, the date wraps to a line of its own inside the plate, which grows. */
.date-row { flex-direction: row; flex-wrap: wrap; }
/* The year, and the GDD loop's score at the line's far end (#380): the year line has the room the date line lacks. */
.year-row { flex-direction: row; justify-content: space-between; align-items: center; }
#score { font-size: 17px; flex-shrink: 0; }
.date-row Label { font-size: 15px; margin-right: 8px; }
.year { -unity-font-definition: url("project://database/Assets/UI/Fonts/EBGaramond-SemiBold.ttf"); font-size: 27px; color: var(--ink); }
.meters { flex-direction: row; flex-grow: 1; align-items: center; }
.meter {
    flex-direction: row; align-items: center; min-width: 130px; flex-shrink: 1; padding: 0 7px 0 6px;
    border-right-width: 1px; border-color: rgba(196, 160, 92, 0.25);
}
/* The icon gives way first in a narrow window (down to 26px), so the caption keeps its line. */
.meter-icon { width: 30px; height: 30px; flex-shrink: 1; min-width: 24px; margin-right: 5px; }
/* With room to spare (HudPresenter sets top-bar--roomy on the one-row bar), the promo's sizes. */
.top-bar--roomy .meter-icon { width: 38px; height: 38px; margin-right: 7px; }
.top-bar--roomy .meter-value { font-size: 24px; }
.meter-body { flex-shrink: 1; flex-grow: 1; min-width: 0; }
.meter-name { font-size: 15px; color: var(--ink); white-space: normal; }
.meter-caption-row { flex-direction: row; align-items: flex-end; }
/* In the bar a long caption wraps rather than widen its meter; on the roomy bar it keeps one line, as in the promo (B8). */
.meter .meter-name { max-width: 120px; }
.top-bar--roomy .meter .meter-name { max-width: none; white-space: nowrap; }
#security-level { font-size: 15px; color: var(--ink-dim); margin-left: 6px; white-space: nowrap; flex-shrink: 0; }
.meter-row { flex-direction: row; align-items: flex-end; }
.meter-value { font-size: 21px; color: var(--ink); }
.meter-delta { font-size: 16px; margin-left: 7px; }
/* The screen buttons: a round, gold-rimmed icon with its name under it (the name keeps them legible without tooltips). */
.nav { flex-direction: row; flex-shrink: 0; align-items: center; }
.nav-button {
    width: 60px; height: 86px; margin: 0 1px; padding: 56px 0 0 0;
    background-color: rgba(0, 0, 0, 0); border-width: 0;
    font-size: 14px; color: var(--ink-dim); -unity-text-align: upper-center; white-space: nowrap;
}
.nav-disc {
    position: absolute; top: 2px; left: 5px; width: 50px; height: 50px; padding: 11px;
    border-radius: 25px; border-width: 1.5px; border-color: var(--gold-dim); background-color: var(--navy-deep);
}
/* New Game in the bar, as promo 03's round bar buttons (HUD round 2, part 3): icon-only; its name is its text, drawn clear
   (the event log reads it), and its tooltip, which HoverTip shows beside it on hover and on focus. */
#new-game.bar-button { width: 52px; height: 52px; margin: 0 10px; padding: 0; font-size: 1px; color: rgba(0, 0, 0, 0); }
#new-game.bar-button:hover, #new-game.bar-button:focus, #new-game.bar-button.nav-open { color: rgba(0, 0, 0, 0); }
#new-game.bar-button .nav-disc { top: 0; left: 0; width: 52px; height: 52px; padding: 13px; border-radius: 26px; }
.nav-button:hover { background-color: rgba(0, 0, 0, 0); color: var(--ink); }
.nav-button:hover .nav-disc { border-color: var(--gold); background-color: var(--navy-raised); }
/* Two separate signals: "open" (ScreenNav's nav-open) is a gold-light rim on a raised disc with a gold caption; keyboard
   focus is an ink rim on the warm focus fill, which a pointer click clears (ScreenNav blurs the button). */
.nav-open { color: var(--gold-light); }
.nav-open .nav-disc { border-color: var(--gold-light); background-color: var(--navy-raised); }
.nav-button:focus { color: var(--ink); }
.nav-button:focus .nav-disc { border-color: var(--ink); background-color: var(--focus); }
/* A window too narrow for the icons (HudPresenter sets top-bar--compact below HudPresenter.CompactBelowPx): the meters
   drop their icons and tighten, as the bar was before the icons. */
.top-bar--compact .meter-icon { display: none; }
.top-bar--compact .date-box { width: 226px; margin-right: 6px; }
.top-bar--compact .date-row Label { font-size: 15px; margin-right: 6px; }
.top-bar--compact .meter { padding: 0 8px; }
/* The narrow HUD (HudPresenter sets hud-narrow on the root, with the compact bar): a taller bar whose meters put the
   change under the value, so no change runs into its neighbour; the panels below the bar move down with it. */
.hud-narrow .top-bar { height: 124px; }
.hud-narrow .right-column, .hud-narrow .left-column, .hud-narrow .event-gutter, .hud-narrow .event-layer, .hud-narrow .screen, .hud-narrow .toast { top: 140px; }
.hud-narrow .meter { min-width: 96px; padding: 0 6px; }
.hud-narrow .meter-row { flex-direction: column; align-items: flex-start; }
.hud-narrow .meter-value { font-size: 22px; }
.hud-narrow .meter-delta { margin-left: 0; font-size: 15px; }
/* Narrower than about square (HudPresenter adds hud-two-row): the bar wraps into two rows, the date badge and the meters
   (78% of the bar, so they always take the first row) above, the screen buttons and End Turn below; the panels move down. */
.hud-two-row .top-bar { height: 216px; padding-top: 6px; padding-bottom: 4px; flex-wrap: wrap; justify-content: space-between; align-content: space-around; }
.hud-two-row .meters { width: 78%; flex-grow: 1; }
.hud-two-row .right-column, .hud-two-row .left-column, .hud-two-row .event-gutter, .hud-two-row .event-layer, .hud-two-row .screen, .hud-two-row .toast { top: 232px; }
/* Narrower still (a phone upright; HudPresenter adds hud-three-row with hud-two-row): the badge, the meters and the
   screen buttons with End Turn take a row each, and the panels move down under the taller bar (#210). */
.hud-three-row .top-bar { height: 312px; }
.hud-three-row .meters { width: 100%; }
.hud-three-row .right-column, .hud-three-row .left-column, .hud-three-row .event-gutter, .hud-three-row .event-layer, .hud-three-row .screen, .hud-three-row .toast { top: 328px; }
.turn-box { width: 150px; flex-shrink: 1; min-width: 150px; align-items: flex-end; }
#attention { font-size: 15px; }   /* the audit's floor (H4): 15 px in the stylesheet */
.end-turn {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/EBGaramond-SemiBold.ttf"); font-size: 20px;
    border-color: var(--gold); border-width: 1.5px; color: var(--gold-light); padding: 2px 12px 2px 38px;
}
.end-turn:hover { border-color: var(--gold-light); }

/* The decision card in the middle (decision cards, 2026-10-13), the info panel at the bottom-left, the minimap at the
   bottom-right. The right-hand column keeps its 480 px width, so the screens and the border layer's caption stay where
   they were; it now holds only the minimap. */
.right-column { position: absolute; right: 16px; top: 112px; bottom: 16px; width: 480px; }
/* HUD round 2, part 2 (#398): promo 03's left icon column, the four screens' round buttons under the bar at the left edge
   (promo 03: discs about 5.3% of the frame's height, 6.3% apart). Icon-only: the caption is the button's text (the event
   log and the strings read it) but drawn clear; HoverTip shows it beside the disc on hover and on focus. The decision
   card's backdrop, the screens and the toast start right of it (68 px: its 56 px and a 12 px gap), so nothing covers it
   and it stays usable under the decision card, as the top bar does; the card itself stays centred in the window. */
.left-column { position: absolute; left: 16px; top: 112px; width: 56px; align-items: center; }
/* The backdrop's strip under the column (review of #602): from the window's left edge to where the backdrop starts (72 px),
   full height (the bar draws over its top), shown and taking the pointer only while the decision card is open. */
.event-gutter { display: none; position: absolute; left: 0; top: 112px; bottom: 0; width: 72px; background-color: rgba(5, 9, 18, 0.55); }
.event-modal .event-gutter { display: flex; }
.left-column .rail-button { width: 56px; height: 56px; margin: 0 0 12px 0; padding: 0; font-size: 1px; color: rgba(0, 0, 0, 0); }
.left-column .rail-button:hover, .left-column .rail-button:focus, .left-column .nav-open { color: rgba(0, 0, 0, 0); }
.left-column .rail-button .nav-disc { top: 0; left: 0; width: 56px; height: 56px; padding: 13px; border-radius: 28px; }
.right-gap { flex-grow: 1; flex-shrink: 0; min-height: 16px; }
/* The decision layer: the room under the bar, top per HUD tier as the column's. While an event is open (event-open on the
   root) the map is blocked: the backdrop dims it and takes the pointer, so map clicks and drags stop at it, and
   ScreenNav.DisableCovered takes the panels under it out of Tab's reach; the top bar stays usable. The card sits in the
   middle. Hide collapses the card to the "Decision
   waiting" button at the layer's top right (EventCardPresenter), which takes no more room than itself. */
.event-layer { position: absolute; left: 16px; right: 16px; top: 112px; bottom: 16px; justify-content: center; align-items: center; }
.event-scrim { display: none; position: absolute; left: 56px; right: -16px; top: 0; bottom: -16px; background-color: rgba(5, 9, 18, 0.55); }
.event-open .event-scrim { display: flex; }
/* The backdrop reaches up to the bar's bottom at every tier: a full-width band from the bar to the layer's top (42 px under the
   70 px one-row bar, where the date plate hangs; 16 px under the taller tiers' bars), then the layer's own part right of
   the left column, and the column's strip (event-gutter) beside and below its discs. No strip of map stays live under a
   card, and the hanging plate is dimmed evenly (review of #624). */
.event-scrim-top { display: none; position: absolute; left: -16px; right: -16px; top: -42px; height: 42px; background-color: rgba(5, 9, 18, 0.55); }
.event-open .event-scrim-top { display: flex; }
.hud-narrow .event-scrim-top, .hud-two-row .event-scrim-top, .hud-three-row .event-scrim-top { top: -16px; height: 16px; }
.event-reopen {
    display: none; position: absolute; right: 0; top: 0; margin: 0; padding: 6px 18px; font-size: 20px; -unity-text-align: middle-center;
    background-color: var(--navy-solid); border-color: var(--gold); border-width: 1.5px; color: var(--gold-light);
}
.event-reopen:hover { border-color: var(--gold-light); }
/* Up to 1040 px wide, its 960 px content holding the 16:9 media header at 960x540 (the photographs' and the clips' size);
   the layer bounds its height. When the window is short the media header gives way first, then the text (it scrolls),
   never the option buttons. */
.event-card { width: 1040px; max-width: 100%; max-height: 100%; flex-shrink: 1; min-height: 0; overflow: hidden; padding: 16px 40px 10px 40px; }
.hud-two-row .event-card { padding-left: 16px; padding-right: 16px; }
/* The card takes the keyboard focus when an event opens (EventCardPresenter.FocusCard): a lighter gold edge says so. */
.event-card:focus { border-color: var(--gold-light); }
.event-card > * { flex-shrink: 0; }
.event-card > .event-scroll { flex-shrink: 1; min-height: 48px; }
#event-options { flex-shrink: 0; }
.event-foot { flex-direction: row; align-items: center; justify-content: space-between; }
.event-count { flex-shrink: 1; white-space: normal; }
.event-hide { font-size: 17px; margin: 2px 0 0 12px; padding: 3px 16px; -unity-text-align: middle-center; }
/* Hidden until EventCardPresenter shows an event (never visible while loading). */
.event-card { display: none; }
/* The card's head is its picture band: a dark plate holding the minister's framed portrait beside the title. */
.event-head {
    flex-direction: row; align-items: center; margin-bottom: 2px; padding: 4px;
    background-color: rgba(5, 9, 18, 0.65); border-width: 1px; border-color: var(--gold-dim); border-radius: 2px;
}
.event-heading { flex-grow: 1; flex-shrink: 1; }
/* Portrait-shaped, so the whole head shows; EventCardPresenter sets background-position-y from the portrait's focal point. */
.event-image {
    width: 96px; height: 128px; flex-shrink: 0; margin-right: 12px; background-size: cover; background-color: var(--navy-deep);
    border-width: 1px; border-color: var(--gold);
}
/* The media header (promo 03 and 05): full width, 16:9 (EventCardPresenter sets its height from the card's width; 540 px
   is the 960 px content's), a gold frame, its credit as a caption strip along the bottom (so the credit costs the card no
   height). It gives way first on a short window (the large flex-shrink takes the shortfall before the text); below its
   credit's height plus EventCardPresenter.MinPhotoHeight it is dropped until the window grows again, so the body and the
   options never scroll for it and the credit (CC BY 4.0) is never cut. */
.event-card > .event-photo {
    display: none; height: 540px; min-height: 0; flex-shrink: 1000; margin-bottom: 4px; overflow: hidden;
    justify-content: flex-end; background-size: cover; background-color: var(--navy-deep); border-width: 1px; border-color: var(--gold);
}
/* The End Turn outcome clip (decision videos, phase 3; OutcomePresenter): over everything but the toast while it plays,
   a dim backdrop that takes the pointer (a click skips) and the clip in a 16:9 frame in the middle (OutcomePresenter sizes
   it from its width), its order under it. */
.outcome-layer { display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0; justify-content: center; align-items: center; background-color: rgba(5, 9, 18, 0.72); padding: 16px; }
.outcome-open .outcome-layer { display: flex; }
.outcome-open .event-layer { display: none; }
.outcome-frame { width: 1000px; max-width: 100%; padding: 16px 20px 12px 20px; align-items: stretch; }
.outcome-media { width: 100%; height: 540px; justify-content: flex-end; background-color: var(--navy-deep); background-size: cover; border-width: 1px; border-color: var(--gold); }
.outcome-label { font-size: 13px; -unity-font-style: italic; -unity-text-align: middle-center; margin: 0; padding: 2px 8px 3px 8px; color: var(--ink); background-color: rgba(5, 9, 18, 0.92); }
.outcome-caption { font-size: 26px; white-space: normal; -unity-text-align: middle-center; margin: 10px 0 2px 0; color: var(--gold-light); }
.outcome-hint { font-size: 15px; -unity-text-align: middle-center; margin: 0; }
/* The Illustration switch (decision videos): over the media header's top right corner (the card's padding plus 8 px; it
   is the card's last child, for the focus order); hidden unless the event has a clip (EventCardPresenter.ApplyIllustration). */
.hud-two-row .event-illustration { right: 24px; }
.event-illustration {
    display: none; position: absolute; top: 24px; right: 48px; margin: 0; padding: 3px 14px; font-size: 17px; -unity-text-align: middle-center;
    background-color: rgba(5, 9, 18, 0.88); border-color: var(--gold); color: var(--gold-light);
}
.event-photo-credit {
    flex-shrink: 0; font-size: 13px; white-space: normal; -unity-text-align: middle-center; margin: 0; padding: 2px 8px 3px 8px;
    color: var(--ink); background-color: rgba(5, 9, 18, 0.92); -unity-font-style: italic;   /* 0.92: blending is linear, so less reads grey */
}
.event-office { white-space: normal; -unity-text-align: middle-center; font-size: 18px; }
/* Options wrap inside the card (playtest 2, P2-2); each has a round gold-rimmed sign at its left, as the promo's choices. */
#event-options Button { white-space: normal; -unity-text-align: middle-left; }
.event-option { min-height: 42px; padding: 5px 12px 5px 46px; margin: 3px 0; border-color: rgba(196, 160, 92, 0.6); }
.event-title { -unity-text-align: middle-center; margin-bottom: 4px; white-space: normal; font-size: 28px; }   /* centred, as before, in the card */
.event-text { white-space: normal; margin-bottom: 8px; }
.draft { display: none; color: var(--down); -unity-font-definition: url("project://database/Assets/UI/Fonts/EBGaramond-SemiBold.ttf"); -unity-text-align: middle-center; }
/* The info panel: the hex's terrain sign (UiIcon on the biome's map colour, InfoPanelPresenter) beside its facts. */
.info-panel { position: absolute; left: 16px; bottom: 16px; width: 520px; min-height: 160px; flex-direction: row; align-items: flex-start; }
.info-thumb {
    width: 92px; height: 116px; flex-shrink: 0; margin-right: 14px; padding: 10px;
    border-width: 1px; border-color: var(--gold); border-radius: 2px; background-color: var(--navy-deep);
}
.info-body { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.info-body > .row { flex-wrap: wrap; }
.info-body > .row Button { margin-right: 6px; font-size: 18px; }
/* Before a hex is chosen only the hint shows (InfoPanelPresenter sets info-empty): a one-line chip that hugs its text, as
   the promo shows no panel until a tile is chosen (HUD round 1, #398). */
.info-panel.info-empty { min-height: 0; width: auto; padding: 8px 16px; }
.info-empty .gold-rule, .info-empty #info-subtitle, .info-empty .reason { display: none; }
.info-empty #info-title { font-size: 20px; }
/* The hex's facts as the promo's icon rows: a gold sign, then the line, which wraps inside the panel (#397). A unit's card
   reuses the lines without the signs (they name a hex's facts, not a unit's). */
.info-row { flex-direction: row; align-items: flex-start; margin-bottom: 3px; }
.info-row-sign { width: 22px; height: 22px; flex-shrink: 0; margin: 3px 10px 0 0; }
.info-row-text { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.info-unit .info-row-sign { display: none; }
/* The border layer's label, beside the minimap's lower left: what the outlines are (MapRegions.Label). Out of the column's
   flex flow (absolute), so it takes no height from the event card at any HUD tier (armistice review I-4). */
.map-layer { display: none; position: absolute; right: 230px; bottom: 0; max-width: 250px; padding: 5px 8px; font-size: 15px; white-space: normal; -unity-text-align: middle-center; color: var(--ink); background-color: rgba(9, 14, 26, 0.9); border-radius: 3px; }
/* A phone upright (three-row bar): the info panel spans the bottom left, beside the minimap, but the column is tall, so the
   label goes back above the minimap, in the column's flow. */
.hud-three-row .map-layer { position: relative; right: auto; bottom: auto; align-self: flex-end; max-width: 480px; margin-bottom: 6px; }
/* HUD round 2 (#398): promo 03's minimap, the painted relief picture with three round buttons beside it, in one frame. The
   picture's box is as wide as the tall picture needs at this height (MinimapPresenter fits the picture to it). */
.minimap { align-self: flex-end; flex-shrink: 0; flex-direction: row; width: 222px; height: 380px; padding: 12px; background-color: rgba(9, 14, 26, 0.97); }
.minimap-map { width: 134px; flex-shrink: 0; justify-content: center; }
.minimap-image { align-self: center; -unity-background-scale-mode: stretch-to-fill; }   /* sized to the picture's aspect by MinimapPresenter */
.minimap-view { position: absolute; border-color: var(--ink); border-width: 1.5px; }
.minimap-buttons { flex-grow: 1; margin-left: 10px; justify-content: space-around; align-items: center; }
.minimap-button { width: 50px; height: 50px; margin: 0; padding: 0; border-width: 0; border-radius: 25px; background-color: rgba(0, 0, 0, 0); }
.minimap-disc {
    position: absolute; left: 0; top: 0; width: 50px; height: 50px; padding: 11px;
    border-radius: 25px; border-width: 1.5px; border-color: var(--gold-dim); background-color: var(--navy-deep);
}
.minimap-button:hover { background-color: rgba(0, 0, 0, 0); }
.minimap-button:hover .minimap-disc { border-color: var(--gold); background-color: var(--navy-raised); }
.minimap-button:focus { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.minimap-button:focus .minimap-disc { border-color: var(--ink); background-color: var(--focus); }
/* A layer switched off (the names or the borders): the disc goes dim, as a lamp turned off. */
.minimap-off .minimap-disc { opacity: 0.6; }   /* the glyph keeps about 4:1 on its disc (MinimapReliefTests) */
/* An icon-only button's name, beside it while hovered or focused (HoverTip): one line, centred on the button's middle. */
.hud-tip {
    display: none; position: absolute; translate: 0 -50%; padding: 4px 10px; font-size: 16px; white-space: nowrap;
    color: var(--ink); background-color: var(--navy-solid); border-color: var(--gold); border-width: 1px; border-radius: 3px;
}

/* Full screens (Cabinet, Budget, Defence, Why) open in the centre, one at a time. */
/* Hidden until ScreenNav opens one (never visible while loading; playtest 2, P2-1). Right edge clear of the 480px column. */
.screen { display: none; position: absolute; left: 552px; right: 512px; top: 112px; bottom: 16px; padding: 18px; background-color: rgb(11, 18, 32); }   /* opaque: a reading screen, and the map labels must not show through */
.screen-header { flex-direction: column; align-items: stretch; border-bottom-width: 1px; border-color: var(--gold-dim); margin-bottom: 10px; padding-bottom: 4px; }
/* Screen titles and section names in gold, letter-spaced, as the promo's "DEFENSE" and "LEADERSHIP". */
.screen-header > .title { color: var(--gold-light); letter-spacing: 1px; }
/* The subtitle sits under the title, the screen's full width, and wraps in a narrow window (#211). A column, not a
   wrapping row: a shrinking, wrapping label in a row re-measured itself every frame (PromoScreensTests idle test). */
.screen-header > .muted { white-space: normal; }
.screen .meter-name { color: var(--gold); letter-spacing: 2px; font-size: 16px; margin-top: 8px; }
.row { flex-direction: row; align-items: center; }
.grow { flex-grow: 1; }
/* A growing row inside a screen (the Cabinet's seats and candidates) takes the height that is left and stretches its
   lists to it, so a long list scrolls instead of growing out of the screen. */
.screen .row.grow { align-items: stretch; flex-basis: 0; flex-shrink: 1; min-height: 0; }
.screen .row.grow > .grow { min-height: 0; flex-shrink: 1; }

/* The toast sits in the map's free top-left corner, above the info panel: opaque, and never over an open screen's title or
   the minimap column (B7). */
.toast {
    display: none; position: absolute; left: 84px; width: 460px; top: 112px; -unity-text-align: middle-center; white-space: normal;
    background-color: var(--navy-solid); border-color: var(--gold); border-width: 1.5px;
}

/* While the decision card is open (ScreenNav.DisableCovered sets event-modal: the card shows and no screen is open) the
   toast's corner is under the card, so it moves to the middle, over the top of the media header, clear of the options. */
.event-modal .toast { left: 25%; right: 25%; width: auto; }

/* Scroll bars in the theme: a slim gold thumb on a faint track, no arrow buttons. */
.unity-scroller--vertical { width: 10px; border-width: 0; background-color: rgba(0, 0, 0, 0); margin-left: 4px; }
.unity-scroller--vertical > .unity-scroller__low-button, .unity-scroller--vertical > .unity-scroller__high-button { display: none; }
.unity-scroller--vertical .unity-base-slider__tracker { background-color: rgba(196, 160, 92, 0.10); border-width: 0; border-radius: 5px; }
.unity-scroller--vertical .unity-base-slider__dragger { background-color: rgba(196, 160, 92, 0.55); border-width: 0; border-radius: 5px; }
.unity-scroller--vertical .unity-base-slider__dragger-border { display: none; }

.why-group { -unity-font-definition: url("project://database/Assets/UI/Fonts/EBGaramond-SemiBold.ttf"); color: var(--gold); letter-spacing: 1px; margin-top: 10px; border-bottom-width: 1px; border-color: rgba(196, 160, 92, 0.25); }
.why-line { white-space: normal; padding-left: 12px; }

/* Wide screens (Cabinet and Defence, laid out as promo/final/04 and 08): from the left edge to the minimap column, over the
   info panel (an opaque reading screen; the info panel is about a hex, not needed while reading a screen). The event card
   and the minimap stay in view (UiLayoutTests). */
.screen-wide { left: 84px; bottom: 100px; }
/* While a wide screen is open the toast's corner (B7) is under it, so the toast moves to the strip the wide screen leaves
   free at the bottom, between the window's left edge and the minimap column: opaque, clear of the screen and the column
   (PromoHudTests.TheToastIsOpaqueAndClearOfTheScreens). Two lines fit. */
.wide-screen-open .toast { top: auto; bottom: 16px; left: 84px; right: 512px; width: auto; padding: 6px 12px; }
/* The info panel under an open wide screen is hidden (ScreenNav sets wide-screen-open): no focus, no clicks, no updates. */
.wide-screen-open .info-panel { display: none; }
.section-title {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/EBGaramond-SemiBold.ttf");
    color: var(--gold); letter-spacing: 3px; font-size: 17px; margin: 0 0 8px 2px; padding: 0;
}
.wrap { white-space: normal; }

/* Bars (UiBar): a dark track and a coloured fill, each fill at least 3:1 against the track (PromoScreensTests). */
.ui-bar { height: 8px; min-width: 40px; flex-grow: 1; flex-shrink: 1; background-color: rgb(34, 42, 58); border-radius: 2px; overflow: visible; }
.ui-bar-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 2px; background-color: var(--gold); }
.ui-bar-mark { position: absolute; top: -4px; bottom: -4px; width: 2px; margin-left: -1px; background-color: var(--ink); }
.ui-bar--competence .ui-bar-fill { background-color: rgb(86, 164, 204); }
.ui-bar--loyalty .ui-bar-fill { background-color: rgb(104, 186, 132); }
.ui-bar--stability .ui-bar-fill { background-color: var(--gold); }
.ui-bar--mobilization .ui-bar-fill { background-color: rgb(152, 178, 96); }
.ui-bar--budget .ui-bar-fill { background-color: rgb(152, 178, 96); }
.big-bar { height: 16px; }

/* Person cards (PersonCard): a framed portrait (or a plate with the initials), then name, office, party and the two bars. */
.seat {
    flex-direction: column; align-items: stretch; justify-content: flex-start; width: 190px;
    padding: 0 0 8px 0; margin: 4px; -unity-text-align: upper-center; border-color: rgba(196, 160, 92, 0.6);
}
.card-plate { height: 150px; flex-shrink: 0; background-color: var(--navy-raised); border-bottom-width: 1px; border-color: var(--gold-dim); overflow: hidden; }
.card-portrait { flex-grow: 1; background-size: cover; }
.card-initials {
    flex-grow: 1; -unity-text-align: middle-center; font-size: 46px; color: rgba(196, 160, 92, 0.75);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/EBGaramond-SemiBold.ttf"); letter-spacing: 2px;
}
.card-name {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/EBGaramond-SemiBold.ttf");
    font-size: 19px; color: var(--ink); -unity-text-align: upper-center; white-space: normal; margin: 6px 6px 0 6px; padding: 0;
}
.card-office { font-size: 15px; color: var(--ink-dim); -unity-text-align: upper-center; white-space: normal; margin: 0 6px; padding: 0; }
.card-party { font-size: 15px; color: var(--gold); -unity-text-align: upper-center; white-space: normal; -unity-font-style: italic; margin: 0 6px 4px 6px; padding: 0; }
.card-stat { flex-direction: row; align-items: center; height: 21px; padding: 0 10px; }
.card-stat-name { width: 82px; flex-shrink: 0; font-size: 14px; color: var(--ink-dim); -unity-text-align: middle-left; padding: 0; margin: 0; }
.card-stat-value { width: 24px; flex-shrink: 0; font-size: 16px; color: var(--ink); -unity-text-align: middle-right; padding: 0; margin: 0; }
.seat-selected { border-color: var(--gold-light); background-color: var(--navy-raised); }
.seat-vacant .card-name { color: var(--ink-dim); }
.appointed { color: var(--gold); }
/* A keyboard-focused card takes the warm focus fill (Button:focus); its dim and gold text turn light to stay legible on it. */
.seat:focus .card-name, .seat:focus .card-office, .seat:focus .card-party, .seat:focus .card-stat-name, .seat:focus .card-stat-value,
.seat:focus .card-initials { color: var(--focus-ink); }

/* The Cabinet: the Prime Minister's card and the appointment list at the side; the house and the cards in the main column. */
.cabinet-side { width: 300px; flex-shrink: 0; margin-right: 14px; }
.cabinet-main { min-width: 0; }
.pm-card { width: auto; margin: 0 0 8px 0; padding-bottom: 12px; }
.pm-card .card-plate { height: 250px; }
.pm-card .card-name { font-size: 27px; color: var(--gold-light); margin-top: 8px; }
.pm-card .card-office { font-size: 17px; }
.pm-card .card-party { font-size: 17px; margin-bottom: 8px; }
.pm-card .card-stat { height: 26px; padding: 0 16px; }
.pm-card .card-stat-name { font-size: 16px; width: 96px; }
.pm-card .ui-bar { height: 10px; }
/* On a short window (1568x752 is 997 logical px tall) the side column is full. The orders line wraps and is never
   squeezed; the candidate list keeps its heading and two rows (220 px), and the Prime Minister's portrait gives way,
   down to the card's text. On a shorter one (32:9 is 764 px) CabinetPresenter.FitPick lowers the list's floor to the room
   left (#41 M7). */
.pm-card { flex-shrink: 1; min-height: 160px; }
.pm-card > * { flex-shrink: 0; }
.pm-card .card-plate { flex-shrink: 1; min-height: 0; }
#cabinet-pick { flex-grow: 1; flex-shrink: 1; min-height: 220px; }
#cabinet-status { white-space: normal; flex-shrink: 0; }
/* The Appoint heading wraps rather than run past the 300 px side column (B5; PromoHudTests.TheAppointHeadingHasRoom). */
#cabinet-pick-title { white-space: normal; }
.pm-offices { flex-direction: row; flex-wrap: wrap; margin: -2px 0 8px 0; flex-shrink: 0; }
.pm-office { font-size: 15px; padding: 3px 10px; margin: 0 6px 4px 0; border-color: rgba(196, 160, 92, 0.6); }
.cabinet-house {
    flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0; margin: 0 5px 8px 5px; padding: 10px 14px;
    background-color: rgba(5, 9, 18, 0.55); border-width: 1px; border-color: var(--gold-dim); border-radius: 2px;
}
.hemicycle-box { width: 320px; height: 168px; flex-shrink: 0; margin-right: 18px; }
.hemicycle { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hemicycle-count { position: absolute; left: 0; right: 0; bottom: 0; align-items: center; }
.house-size { -unity-font-definition: url("project://database/Assets/UI/Fonts/EBGaramond-SemiBold.ttf"); font-size: 34px; color: var(--ink); padding: 0; margin: 0; -unity-text-align: lower-center; }
.house-unit { font-size: 13px; letter-spacing: 2px; color: var(--ink-dim); padding: 0; margin: 0; -unity-text-align: upper-center; }
.house-legend { flex-grow: 1; flex-shrink: 1; min-width: 260px; }
.house-coalition { font-size: 20px; color: var(--ink); white-space: normal; }
.house-stability { flex-grow: 0; height: 8px; margin: 3px 0 6px 0; max-width: 360px; }
.house-legend > Label { padding-top: 0; padding-bottom: 0; }
.party-chips { flex-direction: row; flex-wrap: wrap; margin-top: 6px; }
.party-chip { flex-direction: row; align-items: center; margin: 0 12px 2px 0; }
.party-chip > Label { font-size: 14px; color: var(--ink-dim); padding: 0; margin: 0; }
.party-swatch { width: 11px; height: 11px; border-radius: 6px; margin-right: 5px; }
.party-swatch--hollow { border-width: 1.2px; border-color: var(--ink-dim); }
#cabinet-seats .unity-scroll-view__content-container { flex-direction: row; flex-wrap: wrap; }
.candidate { flex-direction: column; align-items: stretch; margin-bottom: 4px; }
.candidate > Button { white-space: normal; }
.reason { color: var(--ink-dim); font-size: 16px; white-space: normal; flex-shrink: 1; }

/* Defence: three panels side by side that wrap in a narrow window, then the budget share. */
.defence-row { flex-direction: row; flex-wrap: wrap; align-items: stretch; }
.defence-panel {
    margin: 6px; padding: 14px 16px; background-color: rgba(5, 9, 18, 0.55);
    border-width: 1px; border-color: var(--gold-dim); border-radius: 2px;
}
.defence-leadership { flex-grow: 3; flex-basis: 560px; }
.defence-ladder { flex-grow: 2; flex-basis: 380px; }
.defence-callup { flex-grow: 1; flex-basis: 300px; }
.leaders { flex-direction: row; flex-wrap: wrap; justify-content: space-around; }
.leader .card-plate { height: 200px; }
.leader .card-name { font-size: 20px; }
.leader {
    width: 172px; flex-grow: 1; max-width: 230px; margin: 4px; padding-bottom: 8px; background-color: var(--navy-deep);
    border-width: 1px; border-color: rgba(196, 160, 92, 0.6); border-radius: 2px;
}
.rung { flex-direction: row; align-items: center; padding: 8px 10px; margin: 2px 0; border-left-width: 3px; border-color: rgba(0, 0, 0, 0); background-color: rgba(255, 255, 255, 0.03); }
.rung-name { white-space: normal; font-size: 18px; flex-shrink: 1; min-width: 0; }
.rung-turn { font-size: 15px; margin-left: 8px; flex-shrink: 0; }
/* The turn length is a lighter muted than --ink-dim: 15 px text loses about a fifth of its contrast to anti-aliasing, and
   ink-dim's 5.0:1 on a plain rung measured 4.0 to 4.2:1 (#41 re-check). This is 6.3:1, still quieter than ink. */
.rung .rung-turn { color: rgb(190, 184, 170); }
.rung-current { border-color: var(--gold-light); background-color: rgba(196, 160, 92, 0.20); }
.rung-current .rung-name { color: var(--gold-light); }
/* The muted turn length is 3.3:1 on the lit rung; ink is 6.4:1 (#41 M4). */
.rung-current .rung-turn { color: var(--ink); }
/* The level an order will move to at End Turn: a dashed-looking ink edge, distinct from the lit current level. */
.rung-target { border-color: var(--ink); border-left-width: 3px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; }
.big-figure { -unity-font-definition: url("project://database/Assets/UI/Fonts/EBGaramond-SemiBold.ttf"); font-size: 44px; color: var(--ink); padding: 0; margin: 0 0 4px 0; }
.defence-callup .big-bar { flex-grow: 0; margin: 4px 0 10px 0; }
.defence-budget { flex-direction: row; align-items: center; }
.budget-title { margin: 0 18px 0 0; }
.budget-share { margin-left: 16px; font-size: 18px; }
/* A Budget row's office name wraps within the room its buttons leave, so no row is wider than the screen (the
   longest, "Minister of Education and Culture (no office until 10 March 1949)", in either language). */
.budget-office { white-space: normal; flex-shrink: 1; min-width: 0; }
/* A wide screen's header wraps its subtitle under the title when the window is narrow. */
/* Square and narrower windows: a slimmer side column leaves room for two columns of cards. */
.hud-two-row .cabinet-side { width: 250px; }
.hud-two-row .pm-card .card-plate { height: 210px; }
/* #210: in the two-row (narrow) HUD every screen takes the full width under the bar. While one is open the minimap column
   and the info panel under it are hidden (no focus, no clicks), and the toast takes the strip below the screen. */
.hud-two-row .screen { left: 84px; right: 16px; bottom: 100px; }
.hud-two-row.screen-open .right-column, .hud-two-row.screen-open .info-panel { display: none; }
/* Any open screen sits where the decision card does: the card waits, hidden and out of reach, until the screen closes. */
.screen-open .event-layer { display: none; }
.hud-two-row.screen-open .toast { top: auto; bottom: 16px; left: 16px; right: 16px; width: auto; padding: 6px 12px; }
.hud-two-row .cabinet-house { justify-content: center; }

/* Loading (playtest 2, P2-1): until GameRoot is ready only this line shows; the bar's values, the info panel and the
   right-hand column are kept out of sight (visibility, so the layout does not jump when they appear). */
.loading-line { display: none; position: absolute; left: 0; right: 0; top: 45%; -unity-text-align: middle-center; font-size: 28px; color: var(--ink); }
.loading .loading-line { display: flex; }
.root.loading { background-color: var(--navy-solid); }   /* the template's navy, not the default sky (final review M1) */
.loading .date-box, .loading .meters, .loading .nav, .loading .left-column, .loading .turn-box, .loading .info-panel, .loading .right-column, .loading .event-layer { visibility: hidden; }

/* Map labels (visual v1 Task 9; promo HUD pass: rounder, a firmer gold edge): the promo's dark pill with a thin gold edge, in EB Garamond SemiBold. Each pill sits in a
   zero-size slot that MapLabelsPresenter moves with an inline translate; the anchor class says which corner of the pill sits
   on the marker's top. Hidden while the game loads. */
.map-labels { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.loading .map-labels { display: none; }
.map-label-slot { position: absolute; left: 0; top: 0; width: 0; height: 0; overflow: visible; }
.map-label {
    position: absolute;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/EBGaramond-SemiBold.ttf");
    font-size: 18px;
    color: rgb(243, 234, 216);
    background-color: rgba(14, 22, 38, 0.82);
    border-width: 1px;
    border-color: var(--gold);
    border-radius: 14px;
    padding: 1px 12px 2px 12px;
    margin: 0;
    -unity-text-align: middle-center;
    white-space: nowrap;
}
.map-label-city { font-size: 23px; color: rgb(250, 242, 224); }
.map-label-town, .map-label-arab_town { font-size: 19px; }
/* The 1948 localities (named only at close zoom): the same pill, smaller and quieter; today's name in a tooltip under it. */
.map-label-locality { font-size: 15px; padding: 0 9px 1px 9px; color: rgb(232, 222, 200); background-color: rgba(14, 22, 38, 0.72); }
.map-label-tooltip {
    position: absolute;
    translate: -50% 0;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/EBGaramond-SemiBold.ttf");
    font-size: 14px;
    color: rgb(243, 234, 216);
    background-color: rgba(14, 22, 38, 0.92);
    border-width: 1px;
    border-color: var(--gold);
    border-radius: 6px;
    padding: 1px 8px 2px 8px;
    margin: 0;
    white-space: nowrap;
}
.anchor-lower-centre { translate: -50% -100%; }
.anchor-lower-left { translate: 0 -100%; }
.anchor-lower-right { translate: -100% -100%; }

/* The start screen (StartScreenPresenter): the painting of the 14 May 1948 hall, two lines of the Declaration (official
   Hebrew, official English under each), Continue and New Game. Hidden until GameRoot shows it; while it shows (.start-open
   on the root) the HUD under it is hidden, so it takes no focus and no clicks, and the painting is opaque over the map.
   The painting fills the window (cover, anchored at the top centre, so a narrower window crops both sides alike and the
   aisle stays in the middle) and the panel sits at the foot over the audience; a tall window (.start-band) stacks the
   whole painting, as a full-width band, over the panel (StartScreenPresenter.Fit). */
.start-screen { display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--navy-deep); }
.start-open .start-screen { display: flex; }
.start-open .top-bar, .start-open .left-column, .start-open .right-column, .start-open .event-layer, .start-open .info-panel, .start-open .screen, .start-open .map-labels { display: none; }
.start-art {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-image: url("project://database/Assets/UI/StartScreen/declaration-hall.jpg");
    background-size: cover; background-position-x: center; background-position-y: top; background-repeat: no-repeat;
}
.start-band .start-art { bottom: auto; }
.start-body { position: absolute; left: 0; top: 0; right: 0; bottom: 0; flex-direction: column; justify-content: flex-end; align-items: center; padding: 0 16px 28px 16px; }
.start-band .start-body { padding-top: 16px; padding-bottom: 16px; }
.start-panel {
    width: 1240px; max-width: 100%; flex-shrink: 0; align-items: center; padding: 18px 40px 20px 40px;
    background-color: rgba(9, 14, 26, 0.88);
}
.start-title {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/EBGaramond-SemiBold.ttf");
    font-size: 50px; color: var(--gold-light); letter-spacing: 2px; -unity-text-align: middle-center; margin: 0;
}
.start-rule { width: 60%; margin: 2px 0 10px 0; }
/* Hebrew in Frank Ruhl Libre (EB Garamond has no Hebrew; #193) through the advanced text generator, which orders
   right-to-left text and the numbers in it (StartScreenTests renders it and checks the order). */
.start-he {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FrankRuhlLibre/FrankRuhlLibre-Medium.ttf");
    -unity-text-generator: advanced;
    font-size: 34px; color: var(--ink); -unity-text-align: middle-center; white-space: normal; margin: 4px 0 0 0;
}
.start-he-date { font-size: 28px; margin-top: 12px; }
.start-en { font-size: 18px; color: var(--ink-dim); letter-spacing: 1px; -unity-text-align: middle-center; white-space: normal; margin: 2px 0 0 0; }
.start-source { font-size: 15px; color: var(--ink-dim); -unity-text-align: middle-center; white-space: normal; margin: 14px 0 0 0; }
.start-actions { flex-direction: row; flex-wrap: wrap; justify-content: center; margin-top: 14px; }
.start-button {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/EBGaramond-SemiBold.ttf");
    font-size: 24px; min-width: 220px; margin: 4px 10px; padding: 8px 24px; -unity-text-align: middle-center;
}
/* The recording (DeclarationRecording): a quiet button and its credit under the source line; while it plays, its words as
   captions in a dark strip just above the panel, over the painting (the panel is the strip's positioned parent, so the
   strip follows it in every layout). */
.start-recording { display: none; flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: center; margin-top: 8px; }
.start-listen { font-size: 18px; padding: 4px 16px; margin: 2px 10px; -unity-text-align: middle-center; }
.start-recording-credit { font-size: 15px; color: var(--ink-dim); margin: 2px 6px; }
.start-caption {
    display: none; position: absolute; left: 0; right: 0; bottom: 100%; margin-bottom: 12px; padding: 8px 20px 10px 20px;
    align-items: center; background-color: rgba(9, 14, 26, 0.88); border-radius: 3px;
}
.start-caption-he { font-size: 30px; margin: 0; }
.start-caption-en { font-size: 19px; color: var(--ink); white-space: normal; -unity-text-align: middle-center; margin: 4px 0 0 0; }
/* New Game's prompt (the toast) shows at the top of the start screen, clear of the panel. */
.start-open .toast { top: 24px; left: 25%; right: 25%; width: auto; }

/* --- The Hebrew UI (#193; UiLanguage, "?lang=he") -------------------------------------------------------------------
   GameRoot puts .lang-he on the root. Every text is then set in Frank Ruhl Libre (EB Garamond has no Hebrew; one weight,
   so headings lose the semi-bold) through the advanced text generator, which orders right-to-left text and the numbers
   in it. Each rule above that names EB Garamond is listed here; HebrewUiTests fails for one that is missed, including the
   classes only presenters add (it gives a label each). */
.lang-he, .lang-he .title, .lang-he .button, .lang-he Button, .lang-he .year, .lang-he .end-turn, .lang-he .draft,
.lang-he .why-group, .lang-he .section-title, .lang-he .card-initials, .lang-he .card-name, .lang-he .house-size,
.lang-he .big-figure, .lang-he .map-label, .lang-he .map-label-tooltip, .lang-he .start-title, .lang-he .start-button {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FrankRuhlLibre/FrankRuhlLibre-Medium.ttf");
    -unity-text-generator: advanced;
}
/* Mirrored for a right-to-left reader: text is set from the right, every row runs right to left (so a caption's value,
   a card's bars and a button's neighbours follow it on its left), and the side margins swap. What is placed by the map
   stays where it is: the minimap column, the info panel, the toast and the screens' position. Each text's paragraph
   direction is set in code from its own words (UiDirection), because dates, money and names are still English (#55). */
.lang-he { -unity-text-align: upper-right; }
.lang-he .button, .lang-he Button, .lang-he #event-options Button { -unity-text-align: middle-right; }
/* The buttons and cards whose text is centred stay centred (the rule above is the more specific one). */
.lang-he .nav-button, .lang-he .seat { -unity-text-align: upper-center; }
.lang-he .event-reopen, .lang-he .event-hide, .lang-he .event-illustration, .lang-he .start-button, .lang-he .start-listen { -unity-text-align: middle-center; }
.lang-he .card-stat-name { -unity-text-align: middle-right; }
.lang-he .card-stat-value { -unity-text-align: middle-left; }
.lang-he .top-bar, .lang-he .year-row, .lang-he .date-row, .lang-he .meters, .lang-he .meter, .lang-he .meter-row, .lang-he .nav, .lang-he .row,
.lang-he .event-foot, .lang-he .event-head, .lang-he .info-panel, .lang-he .info-row, .lang-he .card-stat, .lang-he .pm-offices,
.lang-he .cabinet-house, .lang-he .party-chips, .lang-he .party-chip, .lang-he .defence-row, .lang-he .leaders, .lang-he .rung,
.lang-he .defence-budget, .lang-he #cabinet-seats .unity-scroll-view__content-container { flex-direction: row-reverse; }
.lang-he.hud-narrow .meter-row { flex-direction: column; align-items: flex-end; }
.lang-he .turn-box { align-items: flex-start; }
.lang-he .top-bar { padding: 0 8px 0 14px; }
.lang-he .date-box { margin-right: 0; margin-left: 10px; padding: 0 12px 0 10px; }
.lang-he .date-row Label { margin-right: 0; margin-left: 8px; }
.lang-he .meter { border-right-width: 0; border-left-width: 1px; padding: 0 6px 0 7px; }
.lang-he .meter-icon { margin-right: 0; margin-left: 5px; }
.lang-he .meter-delta { margin-left: 0; margin-right: 7px; }
.lang-he.hud-narrow .meter-delta { margin-right: 0; }
.lang-he .event-hide { margin: 2px 12px 0 0; }
.lang-he .event-image { margin-right: 0; margin-left: 12px; }
.lang-he .info-thumb { margin-right: 0; margin-left: 14px; }
.lang-he .info-row-sign { margin: 3px 0 0 10px; }
.lang-he .info-body > .row Button { margin-right: 0; margin-left: 6px; }
.lang-he .why-line { padding-left: 0; padding-right: 12px; }
.lang-he .section-title { margin: 0 2px 8px 0; }
.lang-he .cabinet-side { margin-right: 0; margin-left: 14px; }
.lang-he .pm-office { margin: 0 0 4px 6px; }
.lang-he .hemicycle-box { margin-right: 0; margin-left: 18px; }
.lang-he .party-chip { margin: 0 0 2px 12px; }
.lang-he .party-swatch { margin-right: 0; margin-left: 5px; }
.lang-he .rung { border-left-width: 0; border-right-width: 3px; }
.lang-he .rung-target { border-left-width: 1px; border-right-width: 3px; }
.lang-he .rung-turn { margin-left: 0; margin-right: 8px; }
.lang-he .budget-title { margin: 0 0 0 18px; }
.lang-he .budget-share { margin-left: 0; margin-right: 16px; }
/* The option's round sign and End Turn's hourglass are painted on the right in Hebrew (EventCardPresenter, HudPresenter). */
.lang-he .event-option { padding: 5px 46px 5px 12px; }
.lang-he .end-turn { padding: 4px 40px 4px 14px; }
/* A bar fills from the right: the whole bar is flipped, so its fill and its mark (placed from the left in code) follow. */
.lang-he .ui-bar { scale: -1 1; }
