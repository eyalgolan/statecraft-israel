    sensitive: 0
    sensitivityReviewed: 0
  - eventId: idf_founding
    image: {fileID: 2800000, guid: bd09df6e255af486aa2b097209f0a079, type: 3}
    alt: Officers and a rabbi with a banner at the Jerusalem ceremony founding the
