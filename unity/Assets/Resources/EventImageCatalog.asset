  entries:
  - eventId: altalena
    image: {fileID: 2800000, guid: 778f252f061854a6191a38a48bba8dd1, type: 3}
    alt: "The Altalena off the Tel Aviv shore, seen from a seafront caf\xE9 shortly
      before the shelling, June 1948."
    credit: "Benno Rothenberg / Meitar Collection / National Library of Israel /
      The Pritzker Family National Photography Collection \xB7 CC BY 4.0 \xB7 graded
      and cropped"
    sensitive: 1
    sensitivityReviewed: 1
  - eventId: armistice_egypt
    image: {fileID: 2800000, guid: 6a3375c172b3341c48ed637bc90bf014, type: 3}
    alt: IDF and UN officers near the Faluja pocket during the siege of the Egyptian
      brigade, late 1948.
    credit: "Benno Rothenberg / Meitar Collection / National Library of Israel /
      The Pritzker Family National Photography Collection \xB7 CC BY 4.0 \xB7 graded
      and cropped"
    sensitive: 0
    sensitivityReviewed: 0
  - eventId: armistice_jordan
    image: {fileID: 2800000, guid: 1b071919ea9d249d3a94254f72713262, type: 3}
    alt: Members of Israel's delegation beside a United Nations aircraft, leaving
      for armistice talks with Jordan, 1949.
    credit: "Benno Rothenberg / Meitar Collection / National Library of Israel /
      The Pritzker Family National Photography Collection \xB7 CC BY 4.0 \xB7 graded
      and cropped"
    sensitive: 0
    sensitivityReviewed: 0
  - eventId: austerity_1949
    image: {fileID: 2800000, guid: fbdeb44f6ea2348d982ff0887c3259f8, type: 3}
    alt: A clerk hands out the new government ration-coupon books, 1949.
    credit: "Benno Rothenberg / Meitar Collection / National Library of Israel /
      The Pritzker Family National Photography Collection \xB7 CC BY 4.0 \xB7 graded
      and cropped"
    sensitive: 0
    sensitivityReviewed: 0
  - eventId: bernadotte_assassination
    image: {fileID: 2800000, guid: bd6487f6ceba74ad3a9060a52cabc3ba, type: 3}
    alt: UN and Israeli officials salute at Lydda airport as Count Bernadotte's coffin
      leaves for Sweden, September 1948.
    credit: "Benno Rothenberg / Meitar Collection / National Library of Israel /
      The Pritzker Family National Photography Collection \xB7 CC BY 4.0 \xB7 graded
      and cropped"
    sensitive: 1
    sensitivityReviewed: 1
  - eventId: clothing_rationing_1950
    image: {fileID: 2800000, guid: a2430cb25bd4644c3a6040cf18617c73, type: 3}
    alt: Shops on Nahalat Binyamin Street, Tel Aviv, shut in protest after the government
      decided to ration clothing, 1950.
    credit: "Benno Rothenberg / Meitar Collection / National Library of Israel /
      The Pritzker Family National Photography Collection \xB7 CC BY 4.0 \xB7 graded
      and cropped"
    sensitive: 0
    sensitivityReviewed: 0
  - eventId: elections_1949
    image: {fileID: 2800000, guid: 8c959d4b13cfc4b7a8a5ac3c7a46b480, type: 3}
    alt: A voter drops his envelope into the ballot box at a polling station on election
      day, 25 January 1949.
    credit: "Benno Rothenberg / Meitar Collection / National Library of Israel /
      The Pritzker Family National Photography Collection \xB7 CC BY 4.0 \xB7 graded
      and cropped"
    sensitive: 0
    sensitivityReviewed: 0
  - eventId: first_new_yishuv
    image: {fileID: 2800000, guid: 8622975d7ac09487890f20fcc50bc45f, type: 3}
    alt: Two men put up a barbed-wire fence on open ground in the first days of Kibbutz
