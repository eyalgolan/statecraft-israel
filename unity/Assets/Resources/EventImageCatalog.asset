    sensitive: 1
    sensitivityReviewed: 1
  - eventId: operation_horev
    image: {fileID: 2800000, guid: 53720b264363543d5862414d660c8b40, type: 3}
    alt: A column of IDF vehicles and a motorcyclist on a desert track in the Negev
