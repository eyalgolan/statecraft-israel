    sensitive: 0
    sensitivityReviewed: 0
  - eventId: ministry_supply_crisis
    image: {fileID: 2800000, guid: dc210581e182c4a49a80c62a22465013, type: 3}
    alt: Customers at the counter of a Tel Aviv grocery with bare shelves under austerity,
