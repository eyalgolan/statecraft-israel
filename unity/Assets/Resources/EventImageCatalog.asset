    sensitive: 0
    sensitivityReviewed: 0
  - eventId: law_of_return
    image: {fileID: 2800000, guid: 37245b3d68ea14b38b4acd5dca8169db, type: 3}
    alt: The Knesset building, Beit Froumine on King George Street, Jerusalem, 1950.
