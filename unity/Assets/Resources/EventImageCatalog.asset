    sensitive: 1
    sensitivityReviewed: 1
  - eventId: operation_yoav
    image: {fileID: 2800000, guid: 4dbff23757d784486a804849886fb63e, type: 3}
    alt: IDF officers study a map on a jeep as forces move south before Operation
