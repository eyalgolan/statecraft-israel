---
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Figure from '../../components/Figure.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import MediaLabel from '../../components/MediaLabel.astro';
import ContributorsGrid from '../../components/ContributorsGrid.astro';
import { type Lang, languages, href, t, REPO, formatDate, asset } from '../../i18n/ui';
import { capture, concept, flythrough, trailer, gameplay, gameplayVideo, captureDateIso, heroShot } from '../../lib/media';
import { posts } from '../../lib/devlog';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const he = lang === 'he';

const mapShot = capture('build-m3-map.jpg');
const why = capture('build-m3-why.jpg');
// The third feature shows the map in the page's language: the Hebrew interface on the Hebrew page.
const city = he ? capture('build-he-map.jpg') : capture('build-m3-city.jpg');
// The hero is a real screenshot of the build (the LCP image): preloaded as AVIF, never lazy.
const heroWidths = [800, 1200, 1568];
const heroSizes = '100vw';
const heroAvif = await getImage({ src: heroShot.src, widths: heroWidths, format: 'avif', quality: 70 });
const heroWebp = await getImage({ src: heroShot.src, widths: heroWidths, format: 'webp', quality: 78 });
// The heartbeat strip: the two newest devlog posts, from the same data as /devlog.
const recent = posts(lang).slice(0, 2);
const target = concept.find((c) => c.id === 'gameplay-1936')!;
const abs = (p: string) => new URL(p, Astro.site).href;
const poster = await getImage({ src: flythrough.poster, width: 1280, format: 'jpg' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Statecraft: Israel',
  url: abs(href('en')),
  description: t('en', 'site.tagline'),
  genre: ['Strategy', 'Turn-based strategy'],
  gamePlatform: 'Web browser',
  applicationCategory: 'Game',
  operatingSystem: 'Web browser',
  inLanguage: 'en',
  softwareVersion: '0.1.0',
  author: { '@type': 'Person', name: 'Eyal Golan' },
  license: 'https://opensource.org/licenses/MIT',
  sameAs: [REPO],
  image: abs(heroWebp.src),
  // The trailer in the markup is real gameplay, never the AI promo.
  trailer: gameplay ? {
    '@type': 'VideoObject',
    name: gameplay.title.en,
    description: gameplay.description.en,
    thumbnailUrl: abs(heroWebp.src),
    contentUrl: abs(gameplay.sources[gameplay.sources.length - 1].src),
    uploadDate: captureDateIso,
  } : {
    '@type': 'VideoObject',
    name: flythrough.title.en,
    description: flythrough.description.en,
    thumbnailUrl: abs(poster.src),
    contentUrl: abs(asset(flythrough.sources[1].src)),
    uploadDate: '2026-10-10',
    duration: flythrough.duration,
  },
};

const pitch = he
  ? 'משחק אסטרטגיה מבוסס־תורות על ניהול מדינת ישראל. אתם ראש הממשלה ב־15 במאי 1948. השרים אמיתיים, המפה אמיתית, ולכל עובדה היסטורית יש מקור.'
  : 'A turn-based grand-strategy game about governing Israel. You are the prime minister on 15 May 1948. The ministers are the real ones, the map is real, and every historical fact comes with a source.';

const features = [
  {
    item: mapShot, crop: '100% 0%',
    title: he ? 'החלטות אמיתיות במועדן האמיתי' : 'Real decisions at their real dates',
    text: he
      ? 'ההפוגה הראשונה, פרשת אלטלנה ורצח ברנדוט מגיעים במועדם, עם מקורות.'
      : 'The First Truce, the Altalena affair and the Bernadotte assassination arrive on their real dates, with sources.',
  },
  {
    item: why,
    title: he ? 'למה זה קרה?' : 'Why did that happen?',
    text: he
      ? 'לוח "למה?" מראה מה השתנה בכל תור ומה גרם לזה.'
      : 'The “Why?” panel shows what changed each turn, and what caused it.',
  },
  {
    item: city,
    title: he ? 'מפה מנתונים אמיתיים' : 'A map built from real data',
    text: he
      ? 'השטח בנוי מנתוני גובה וגשם אמיתיים, והמסילות והדרכים של 1948 שורטטו ממפות התקופה.'
      : 'The terrain comes from real elevation and rainfall data, and the 1948 railways and roads are traced from maps of the time.',
  },
];
---
<Layout lang={lang} page="" jsonLd={jsonLd}
  preload={[{ srcset: heroAvif.srcSet.attribute, sizes: heroSizes, type: 'image/avif' }]}>
  <section class="hero" aria-labelledby="hero-title">
    <figure class="hero-media media" data-kind="engine">
      <picture>
        <source type="image/avif" srcset={heroAvif.srcSet.attribute} sizes={heroSizes} />
        <img src={heroWebp.src} srcset={heroWebp.srcSet.attribute} sizes={heroSizes} width={heroShot.src.width}
          height={heroShot.src.height} alt={heroShot.alt[lang]} fetchpriority="high" loading="eager" decoding="sync" />
      </picture>
      <figcaption class="hero-label">
        <MediaLabel lang={lang} kind="engine" build={heroShot.build} />
      </figcaption>
    </figure>
    <div class="hero-copy">
      <div class="wrap">
      <h1 id="hero-title" class="lockup" lang="en">
        <span class="lk-small">Statecraft<span class="visually-hidden">:</span></span>
        <span class="lk-big">Israel</span>
      </h1>
      <p class="lk-era plaque plaque-center"><span class="ltr">1948–1951</span></p>
      <div class="btn-row">
        <a class="btn btn-primary" href={href(lang, 'play')}>{t(lang, 'cta.play')}</a>
        <a class="btn" href={REPO}>{t(lang, 'cta.github')}</a>
      </div>
      </div>
    </div>
  </section>

  <aside class="heartbeat seam" aria-label={he ? 'מה חדש' : 'Latest'}>
    <div class="wrap hb">
      {recent.map((p) => (
        <p class="hb-item"><span class="hb-k">{he ? 'יומן פיתוח' : 'Devlog'}</span>
          <time datetime={p.date}>{formatDate(lang, p.date)}</time>{' · '}<a href={`${href(lang, 'devlog')}#${p.slug}`}>{p.title}</a></p>
      ))}
      <p class="hb-item"><a href={`${href(lang, 'devlog')}rss.xml`} type="application/rss+xml">RSS</a></p>
    </div>
  </aside>

  <section class="section band-grain seam" aria-labelledby="what"><div class="wrap">
    <h2 id="what" class="visually-hidden">{he ? 'על מה המשחק' : 'What it is'}</h2>
    <p class="pitch">{pitch}</p>
    <p class="muted prose what-note">{he
      ? 'המשחק עוסק במלחמה, בטרור ובשואה כאירועים היסטוריים. המסגור שלו ישראלי, ואף ציטוט אינו בדוי. זה אב־טיפוס מוקדם.'
      : 'The game deals with war, terror and the Holocaust as historical events. Its framing is Israeli, and no quotes are invented. It is an early prototype.'}
      {' '}<a href={href(lang, 'history/sources')}>{t(lang, 'nav.sources')}</a></p>
  </div></section>

  {/* The real gameplay clip, behind a click: the hero is a clean still, so the first screen loads no video. */}
  <section class="section" aria-labelledby="footage"><div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{he ? 'צילום מתוך המשחק' : 'In-engine footage'}</span>
      <h2 id="footage" class="plaque">{gameplayVideo ? (he ? 'כך זה נראה כשמשחקים' : 'What playing looks like') : (he ? 'המפה, מהנגב ועד חיפה' : 'The map, from the Negev to Haifa')}</h2>
    </div>
    <VideoFacade video={gameplayVideo ?? flythrough} lang={lang} />
  </div></section>

  <section class="section" aria-labelledby="features"><div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{he ? 'במשחק' : 'In the game'}</span>
      <h2 id="features" class="plaque">{he ? 'מה עושים בכל תור' : 'What you do each turn'}</h2>
    </div>
    <div class="features">
      {features.map((f) => (
        <article class="feature">
          <Figure item={f.item} lang={lang} objectPosition={f.crop} class={f.crop ? 'crop' : undefined}
            sizes="(min-width: 76rem) 40rem, (min-width: 48rem) 55vw, 100vw" />
          <div class="feature-text">
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div></section>

  <section class="concept-band seam" aria-labelledby="target">
    <div class="wrap section-head">
      <span class="label label-concept">{t(lang, 'label.concept')}</span>
      <h2 id="target" class="plaque">{he ? 'המראה שאליו אנחנו שואפים' : 'The look we are building toward'}</h2>
      <p>{he
        ? 'אמנות קונספט שנוצרה בבינה מלאכותית. זו לא הגרסה הנוכחית.'
        : 'Concept art made with AI. It is not the current build.'}</p>
    </div>
    <Figure item={target} lang={lang} sizes="100vw" widths={[800, 1200, 1600, 2400]} class="band-figure" />
  </section>

  <section class="section promo seam" aria-labelledby="promo"><div class="wrap">
    <div class="section-head">
      <span class="label label-cinematic">{t(lang, 'label.cinematic')}</span>
      <h2 id="promo" class="plaque">{he ? 'הטריילר' : 'The trailer'}</h2>
      <p>{he
        ? 'נוצר בכלי וידאו של בינה מלאכותית מאמנות הקונספט שלנו. זה אינו צילום מהמשחק.'
        : 'Made with AI video tools from our concept art. It is not gameplay.'}</p>
    </div>
    <VideoFacade video={trailer} lang={lang} />
  </div></section>

  <section class="section honest" aria-labelledby="honest"><div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{he ? 'בגלוי' : 'In the open'}</span>
      <h2 id="honest" class="plaque">{he ? 'מה אמיתי ומה לא' : 'What is real and what is not'}</h2>
    </div>
    <div class="cards3">
      <div class="panel">
        <h3>{he ? 'תוויות' : 'Labels'}</h3>
        <p>{he
          ? 'כל תמונה וסרטון אומרים מה הם: צילום מתוך המשחק, אמנות קונספט של בינה מלאכותית, או פרומו של בינה מלאכותית.'
          : 'Every image and video says what it is: an in-engine capture, AI concept art, or an AI promo.'}</p>
        <a href={href(lang, 'media')}>{t(lang, 'nav.media')}</a>
      </div>
      <div class="panel">
        <h3>{he ? 'מקורות' : 'Sources'}</h3>
        <p>{he
          ? 'לכל אירוע, שר ותאריך יש מקורות. עדיין אף היסטוריון לא בדק את המשחק.'
          : 'Every event, minister and date cites its sources. No historian has reviewed the game yet.'}</p>
        <a href={href(lang, 'history/sources')}>{t(lang, 'nav.sources')}</a>
      </div>
      <div class="panel">
        <h3>{he ? 'בינה מלאכותית' : 'AI use'}</h3>
        <p>{he
          ? 'הקוד, אמנות הקונספט והטריילר הקולנועי נעשו בסיוע נרחב של בינה מלאכותית. מודלי התלת־ממד הם של MATKOT. דבר אינו נוצר בזמן אמת במהלך המשחק.'
          : 'The code, the concept art and the cinematic trailer were made with heavy AI assistance. The 3D models are by MATKOT. Nothing is generated live while you play.'}</p>
        <a href={href(lang, 'how-we-make-it')}>{t(lang, 'nav.how')}</a>
      </div>
    </div>
  </div></section>

  <section class="section band-grain closing" aria-labelledby="join"><div class="wrap">
    <h2 id="join" class="plaque">{he ? 'להשתתף' : 'Take part'}</h2>
    <div class="btn-row">
      <a class="btn btn-primary" href={href(lang, 'contribute')}>{t(lang, 'nav.contribute')}</a>
      <a class="btn" href={`${REPO}/discussions`}>{he ? 'דיונים' : 'Discussions'}</a>
      <a class="btn" href={`${REPO}/issues/new?template=historical_accuracy.yml`}>{he ? 'דיווח על טעות היסטורית' : 'Report a historical error'}</a>
    </div>
  </div></section>

  <section class="section contributors" aria-labelledby="people"><div class="wrap">
    <div class="section-head">
      <h2 id="people" class="plaque">{t(lang, 'nav.contributors')}</h2>
    </div>
    <ContributorsGrid lang={lang} level="h3" />
  </div></section>

</Layout>

<style>
  .hero { position: relative; background: var(--navy-deep); }
  .hero-media { margin: 0; position: relative; }
  /* Proposal v2: the key-art hero. The real build fills the first screen, as Civ's key art does, with the lockup centred
     at the bottom over a gradient to navy and one gold button. The pitch moves to the band below. */
  .hero-media img { inline-size: 100%; block-size: min(calc(100svh - var(--header-h)), 56.25vw); min-block-size: 30rem; object-fit: cover; object-position: 50% 30%; } /* 16:9 at most, so the game's own HUD is never cut */
  .hero-label { position: absolute; inset-block-end: 1.1rem; inset-inline-end: var(--gutter); padding: 0; z-index: 3; display: flex; gap: 0.5rem; align-items: center; }
  .hero-label :global(.label) { background: rgba(9, 14, 26, 0.92); margin: 0; font-size: 0.85rem; }
  .hero-copy {
    position: absolute; inset-inline: 0; inset-block-end: 0; padding-block: 6rem 3rem;
    /* The lockup sits higher than the old h1, so the scrim stays dark further up (checked at the brightest sand). */
    background: linear-gradient(to top, rgba(9, 14, 26, 0.97) 0%, rgba(9, 14, 26, 0.92) 68%, rgba(9, 14, 26, 0.78) 84%, rgba(9, 14, 26, 0) 100%);
  }
  .hero-copy .wrap { text-align: center; }
  .hero-copy .wrap > * { max-inline-size: 48rem; margin-inline: auto; }
  .hero-copy .btn-row { justify-content: center; }
  .hero-copy .btn { font-size: 1.1rem; padding-inline: 1.8em; min-block-size: 3.1rem; }
  .hero-label { inset-block-start: auto; }
  /* Proposal: the title lockup, in live text (Civ sets its lockup as an image inside an h1). STATECRAFT small and
     spaced above a large ISRAEL in gilt, then the era. The h1 is English on both pages, so its letter-spacing never
     touches Hebrew; the era line is digits only. */
  .lockup { margin-block-end: 0.15em; font-family: var(--serif); line-height: 1; }
  .lk-small { display: block; text-shadow: 0 1px 2px rgba(9, 14, 26, 0.9); font-size: clamp(0.95rem, 0.8rem + 0.6vw, 1.3rem); letter-spacing: 0.42em; text-transform: uppercase; color: var(--ink); font-weight: 600; margin-block-end: 0.2em; }
  .lk-big {
    display: block; font-size: clamp(3.1rem, 1.9rem + 5.2vw, 6.4rem); letter-spacing: 0.07em; text-transform: uppercase; font-weight: 600;
    color: var(--gold-light);
    background: linear-gradient(180deg, var(--gold-light) 0%, #f3e2b4 38%, #d8b874 62%, var(--gold-light) 100%);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 2px 0 rgba(0, 0, 0, 0.55));
  }
  @media (forced-colors: active) { .lk-big { background: none; -webkit-text-fill-color: currentColor; filter: none; } }
  .lk-era { font-size: 1rem; letter-spacing: 0.3em; color: var(--gold-light); font-weight: 600; margin-block-end: 1.1rem; }
  .lk-era::after { inline-size: min(16.25rem, 60%); }
  :lang(he) .lk-era { letter-spacing: 0; } /* the rule is no letter-spacing on Hebrew pages; the range is wrapped in .ltr */
  .pitch { font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.75rem); line-height: 1.45; text-align: center; max-inline-size: 46rem; margin: 0 auto clamp(2.5rem, 5vw, 4rem); color: var(--ink); text-wrap: balance; }
  @media (max-width: 48rem) {
    .hero-media img { block-size: auto; min-block-size: 0; max-block-size: none; aspect-ratio: 4 / 3; object-position: 38% 50%; }
    .hero-copy { position: static; background: var(--navy-deep); padding-block: 1.5rem 2rem; }
    /* The label and the pause button leave the picture on phones: a caption bar under it, on one line each,
       instead of a pill that wrapped into three columns over the video (the 390px bug). */
    .hero-label { position: static; justify-content: space-between; padding: 0.5rem var(--gutter); background: var(--navy-solid); border-block-end: 1px solid var(--gold-faint); }
    .hero-label :global(.label) { min-inline-size: 0; }
    .hero-label :global(.label) { font-size: 0.8rem; }
  }
  .heartbeat { background: var(--navy-solid); border-block-end: 0; }
  .hb { display: flex; flex-wrap: wrap; gap: 0.35rem 1.4rem; padding-block: 0.9rem; font-size: 0.9rem; color: var(--ink-dim); }
  .hb-item { margin: 0; }
  .hb-k { color: var(--gold); font-weight: 600; margin-inline-end: 0.4em; }
  .hb a { color: var(--ink); }
  /* Larger imagery: the feature pictures take about two thirds of a wider column. */
  .features { display: grid; gap: clamp(3rem, 7vw, 6rem); }
  .feature { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: clamp(1.25rem, 4vw, 3.5rem); align-items: center; }
  .feature-text h3 { font-size: clamp(1.5rem, 1.2rem + 1vw, 2.1rem); }
  .feature:nth-child(even) > :global(figure) { order: 2; }
  .feature:nth-child(even) { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); }
  .feature :global(.crop .media-frame img) { aspect-ratio: 4 / 3; object-fit: cover; }
  .feature-text p { color: var(--ink-dim); }
  @media (max-width: 48rem) {
    .feature, .feature:nth-child(even) { grid-template-columns: 1fr; }
    .feature:nth-child(even) > :global(figure) { order: 0; }
  }
  /* The promo 03 band: once, edge to edge, with its label on the picture and in the heading, and the AI mark. */
  .concept-band { padding-block: clamp(3rem, 7vw, 5.5rem) 0; background: var(--navy-deep); }
  .concept-band :global(.band-figure .media-frame) { border-inline: 0; box-shadow: none; border-block: 1px solid var(--gold-dim); }
  .concept-band :global(.band-figure figcaption) { max-inline-size: var(--wide); margin-inline: auto; padding: 0.6rem var(--gutter) 0; }
  .cards3 { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
  .cards3 p { color: var(--ink-dim); font-size: 0.97em; }
  .closing .btn-row { margin-block-start: 1.25rem; }
  .what-note { text-align: center; margin-inline: auto; }
</style>

