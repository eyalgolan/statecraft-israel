---
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Figure from '../../components/Figure.astro';
import PersonPortrait from '../../components/PersonPortrait.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import MediaLabel from '../../components/MediaLabel.astro';
import { type Lang, languages, href, t, REPO, formatDate, asset } from '../../i18n/ui';
import { capture, engine, concept, flythrough, trailer, gameplay, gameplayVideo, captureDateIso, heroShot } from '../../lib/media';
import { posts } from '../../lib/devlog';
import { roadmap, cabinet as cabinetPeople } from '../../lib/repo';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const he = lang === 'he';

const mapShot = capture('build-m3-map.jpg');
const why = capture('build-m3-why.jpg');
const topdown = engine.find((e) => e.id === 'm2-topdown')!;
// The hero is a real screenshot of the build (the LCP image): preloaded as AVIF, never lazy.
const heroWidths = [800, 1200, 1568];
const heroSizes = '100vw';
const heroAvif = await getImage({ src: heroShot.src, widths: heroWidths, format: 'avif', quality: 70 });
const heroWebp = await getImage({ src: heroShot.src, widths: heroWidths, format: 'webp', quality: 78 });
// The heartbeat strip: the release and the two newest devlog posts, from the same data as /devlog (proposal).
const recent = posts(lang).slice(0, 2);
const phases = roadmap(lang);
// Proposal v2: the cabinet strip (archival portraits from the game's own catalogue) and the promo 03 concept band.
const people = cabinetPeople();
const cabinetCount = people.length;
// The first six of the government, by office: a portrait where one may be shown, otherwise the lettered plate.
const ministers = people.filter((p) => p.group === 'government').slice(0, 6);
const target = concept.find((c) => c.id === 'gameplay-1936')!;
const stateWord = (s: string) => ({
  done: he ? 'הושלם' : 'Done', now: he ? 'בתהליך' : 'In progress', next: he ? 'הבא' : 'Next', later: he ? 'בהמשך' : 'Later',
} as Record<string, string>)[s];
const abs = (p: string) => new URL(p, Astro.site).href;
const poster = await getImage({ src: flythrough.poster, width: 1280, format: 'jpg' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Statecraft: Israel',
  url: abs(href('en')),
  description: t('en', 'site.tagline'),
  genre: ['Strategy', 'Turn-based strategy'],
  gamePlatform: 'Web browser',
  applicationCategory: 'Game',
  operatingSystem: 'Web browser',
  inLanguage: 'en',
  softwareVersion: '0.1.0',
  author: { '@type': 'Person', name: 'Eyal Golan' },
  license: 'https://opensource.org/licenses/MIT',
  sameAs: [REPO],
  image: abs(heroWebp.src),
  // The trailer in the markup is real gameplay, never the AI promo.
  trailer: gameplay ? {
    '@type': 'VideoObject',
    name: gameplay.title.en,
    description: gameplay.description.en,
    thumbnailUrl: abs(heroWebp.src),
    contentUrl: abs(gameplay.sources[gameplay.sources.length - 1].src),
    uploadDate: captureDateIso,
  } : {
    '@type': 'VideoObject',
    name: flythrough.title.en,
    description: flythrough.description.en,
    thumbnailUrl: abs(poster.src),
    contentUrl: abs(asset(flythrough.sources[1].src)),
    uploadDate: '2026-10-10',
    duration: flythrough.duration,
  },
};

const pitch = he
  ? 'משחק אסטרטגיה מבוסס־תורות על ניהול מדינת ישראל. אתם ראש הממשלה ב־15 במאי 1948. השרים אמיתיים, המפה אמיתית, ולכל עובדה היסטורית יש מקור.'
  : 'A turn-based grand-strategy game about governing Israel. You are the prime minister on 15 May 1948. The ministers are the real ones, the map is real, and every historical fact comes with a source.';

const features = [
  {
    item: mapShot, crop: '100% 0%',
    title: he ? 'החלטות אמיתיות במועדן האמיתי' : 'Real decisions at their real dates',
    text: he
      ? 'ההפוגה הראשונה, פרשת אלטלנה ורצח ברנדוט מגיעים במועדם, ולכל אירוע יש מקורות. בעמוד ההיסטוריה מופיעים כל האירועים שבמשחק, עם המקורות שלהם.'
      : 'The First Truce, the Altalena affair and the Bernadotte assassination arrive at their real dates, and every event cites its sources. The History page lists every event in the game with them.',
  },
  {
    item: why,
    title: he ? 'למה זה קרה?' : 'Why did that happen?',
    text: he
      ? 'לוח "למה?" מפרט מה השתנה בכל תור ומה גרם לכל שינוי. מתחת רצה סימולציה דטרמיניסטית ב־C#: אותן בחירות תמיד נותנות אותה תוצאה, ומשחק שמור הוא זרע ההגרלה ורשימת הפקודות.'
      : 'The “Why?” panel lists what changed in a turn and the cause of each change. Underneath runs a deterministic C# simulation: the same choices always give the same result, and a saved game is the seed plus the list of commands.',
  },
  {
    item: topdown,
    title: he ? 'מפה מנתונים אמיתיים' : 'A map built from real data',
    text: he
      ? 'מפת השטח נבנתה מנתוני גובה (Copernicus DEM) ומנתוני גשם (CHELSA ותחנות השירות המטאורולוגי). קווי הרכבת והדרכים של 1948 שורטטו על מפות Survey of Palestine.'
      : 'The terrain is built from elevation data (Copernicus DEM) and rainfall data (CHELSA and the Israel Meteorological Service’s gauges). The railways and roads of 1948 are traced on Survey of Palestine maps.',
  },
];

const works = he
  ? ['תורות חודשיים מ־15 במאי 1948 ועד 15 בינואר 1952.', 'מסך הפתיחה.', 'מפת 1948: עיירות, כפרים ומאהלי בדואים, מסילות ודרכים, השטחים שבידי כל צד מ־11 ביוני 1948, ואזורי שביתת הנשק וקוויה מ־1949, מתאריך כל הסכם.', 'עיירות וכפרים שגודלם לפי אוכלוסייתם ב־1945, ביניהם העיר הלבנה של תל אביב וכפרי האבן הערביים, עם מטעי זיתים והדרים.', 'החטיבות של 1948, טייסת 101 וספינות חיל הים הראשונות, כאסימונים במיקומים המתועדים שלהם. הם עוד לא מקבלים פקודות.', 'מסך הממשלה עם מינויים.', 'מסך התקציב, והסרגל העליון עם כסף ותמיכה בינלאומית.', 'מסך הביטחון עם סולם ההסלמה וגיוס המילואים.', 'אירועים היסטוריים עם מקורות, ממלחמת 1948 ועד משבר המטבע הזר של 1951, ולרובם צילום ארכיון.', 'לוח "למה?".', 'שמירה אוטומטית וטעינה.', 'גרסת הדפדפן (WebGL), שבונים מקוד המקור.']
  : ['Monthly turns from 15 May 1948 to 15 January 1952.', 'The start screen.', 'The 1948 map: towns, villages and Bedouin camps, railways and roads, the areas each side held from 11 June 1948, and the 1949 armistice zones and lines from each agreement’s date.', 'Towns and villages sized by their 1945 population, among them Tel Aviv’s White City and the stone Arab villages, with olive and citrus groves.', 'The 1948 brigades, 101 Squadron and the first navy ships as tokens at their sourced positions. They take no orders yet.', 'The Cabinet with appointments.', 'The Budget screen, and the top bar with Money and International support.', 'The Defence screen with the escalation ladder and reserve call-up.', 'Sourced historical events from the 1948 war through the 1951 foreign-currency crisis, most with an archival photograph.', 'The “Why?” panel.', 'Autosave and load.', 'The browser (WebGL) build, built from source.'];
const missing = he
  ? ['האמנות שבתמונות הקונספט. היישובים והעצים הם עדיין מודלים פרוצדורליים; דגמי הבניינים ו"אוסף 1948" של טל כבר במאגר, אבל עוד לא על המפה.', 'רוב מה שב־GDD: יחידות שמאמנים ומפקדים עליהן, ערים עם דיור ותעסוקה, בנייה, קרבות ושלוש המטרות. בסימולציה יש כבר חלק ראשון מהם (תל אביב, אימון, יישוב חדש אחד והמטרה הראשונה), אבל עוד אין מסך שנותן את הפקודות האלה.', 'דיפלומטיה.', 'כל מה שאחרי 15 בינואר 1952.', 'גרסה מתארחת שאפשר לשחק בה בלחיצה אחת.']
  : ['The art in the concept images. Towns and trees are still procedural models; Tal’s building models and 1948 Collection are in the repository but not yet on the map.', 'Most of the GDD: units you train and command, cities with housing and jobs, construction, combat and the three objectives. The sim has a first slice of these (Tel Aviv, training, one new settlement and the first objective), but no screen gives their orders yet.', 'Diplomacy.', 'Anything after 15 January 1952.', 'A hosted build you can play with one click.'];
---
<Layout lang={lang} page="" jsonLd={jsonLd}
  preload={[{ srcset: heroAvif.srcSet.attribute, sizes: heroSizes, type: 'image/avif' }]}>
  <section class="hero" aria-labelledby="hero-title">
    <figure class="hero-media media" data-kind="engine">
      <picture>
        <source type="image/avif" srcset={heroAvif.srcSet.attribute} sizes={heroSizes} />
        <img src={heroWebp.src} srcset={heroWebp.srcSet.attribute} sizes={heroSizes} width={heroShot.src.width}
          height={heroShot.src.height} alt={heroShot.alt[lang]} fetchpriority="high" loading="eager" decoding="sync" />
      </picture>
      <figcaption class="hero-label">
        <MediaLabel lang={lang} kind="engine" build={heroShot.build} />
      </figcaption>
    </figure>
    <div class="hero-copy">
      <div class="wrap">
      <h1 id="hero-title" class="lockup" lang="en">
        <span class="lk-small">Statecraft<span class="visually-hidden">:</span></span>
        <span class="lk-big">Israel</span>
      </h1>
      <p class="lk-era plaque plaque-center"><span class="ltr">1948–1951</span></p>
      <div class="btn-row">
        <a class="btn btn-primary" href={href(lang, 'play')}>{t(lang, 'cta.play')}</a>
        <a class="btn" href={REPO}>{t(lang, 'cta.github')}</a>
      </div>
      <p class="hero-version"><span>{t(lang, 'version')}</span> · {t(lang, 'cta.play.note')}</p>
      </div>
    </div>
  </section>

  <aside class="heartbeat seam" aria-label={he ? 'מה חדש' : 'Latest'}>
    <div class="wrap hb">
      <p class="hb-item"><span class="hb-k">{he ? 'גרסה' : 'Release'}</span> {t(lang, 'version')}</p>
      {recent.map((p) => (
        <p class="hb-item"><span class="hb-k">{he ? 'יומן פיתוח' : 'Devlog'}</span>
          <time datetime={p.date}>{formatDate(lang, p.date)}</time>{' · '}<a href={`${href(lang, 'devlog')}#${p.slug}`}>{p.title}</a></p>
      ))}
      <p class="hb-item"><a href={`${href(lang, 'devlog')}rss.xml`} type="application/rss+xml">RSS</a></p>
    </div>
  </aside>

  <section class="section band-grain seam" aria-labelledby="what"><div class="wrap">
    <p class="pitch">{pitch}</p>
    <div class="split split-status">
      <div class="prose">
        <span class="eyebrow">{he ? 'על מה המשחק' : 'What it is'}</span>
        <h2 id="what" class="plaque">{he ? 'אתם בכיסא ראש הממשלה מיום הקמת המדינה' : 'You sit in the prime minister’s chair from the founding of the state'}</h2>
        {he ? (
          <p>בכל תור אתם ממנים ומחליפים שרים אמיתיים בתוך קואליציה אמיתית, מחלקים תקציב זעום בין ביטחון, קליטת עלייה, המעברות והצנע, מנהלים את הביטחון על סולם הסלמה בן חמש דרגות, מאיומים שגרתיים ועד מלחמה כוללת, ומכריעים בהחלטות אמיתיות במועדן האמיתי.</p>
        ) : (
          <p>Each turn you appoint and replace real ministers inside a real coalition, divide a tiny budget between security, immigrant absorption, the ma’abarot transit camps and austerity, manage security on a five-level escalation ladder from routine threats to full war, and face real decisions at their real dates.</p>
        )}
        <p class="muted">{he
          ? 'המשחק עוסק במלחמה, בטרור ובשואה כאירועים היסטוריים. המסגור שלו ישראלי, לכל עובדה יש מקור, ואף ציטוט אינו בדוי.'
          : 'The game deals with war, terror and the Holocaust as historical events. Its framing is Israeli, every fact cites a source, and no quotes are invented.'}
          {' '}<a href={href(lang, 'history/sources')}>{t(lang, 'nav.sources')}</a></p>
      </div>
      <div class="status panel">
        <h3>{he ? 'מה עובד היום בקוד המקור' : 'What works now in the source code'}</h3>
        <ul>{works.map((w) => <li>{w}</li>)}</ul>
        <h3>{he ? 'מה עוד חסר' : 'What is missing'}</h3>
        <ul>{missing.map((w) => <li>{w}</li>)}</ul>
      </div>
    </div>
  </div></section>

  {/* The real gameplay clip, behind a click: the hero is now a clean still, so the first screen loads no video. */}
  <section class="section" aria-labelledby="footage"><div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{he ? 'צילום מתוך המשחק' : 'In-engine footage'}</span>
      <h2 id="footage" class="plaque">{gameplayVideo ? (he ? 'כך זה נראה כשמשחקים' : 'What playing looks like') : (he ? 'המפה, מהנגב ועד חיפה' : 'The map, from the Negev to Haifa')}</h2>
      <p>{he
        ? 'הסרטון הראשון באתר מצולם מתוך המשחק עצמו. הטריילר הקולנועי, שנוצר בכלי בינה מלאכותית, מופיע אחריו עם תווית משלו.'
        : 'The first video on this site is recorded in the game itself. The cinematic trailer, made with AI tools, follows below under its own label.'}</p>
    </div>
    <VideoFacade video={gameplayVideo ?? flythrough} lang={lang} />
  </div></section>

  <section class="section" aria-labelledby="features"><div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{he ? 'במשחק' : 'In the game'}</span>
      <h2 id="features" class="plaque">{he ? 'מה עושים בכל תור' : 'What you do each turn'}</h2>
    </div>
    <div class="features">
      {features.map((f) => (
        <article class="feature">
          <Figure item={f.item} lang={lang} objectPosition={f.crop} class={f.crop ? 'crop' : undefined}
            sizes="(min-width: 76rem) 40rem, (min-width: 48rem) 55vw, 100vw" />
          <div class="feature-text">
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div></section>

  <section class="section band-grain" aria-labelledby="cabinet"><div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{he ? 'השרים' : 'The ministers'}</span>
      <h2 id="cabinet" class="plaque">{he ? 'ממשלה אמיתית, שר אחר שר' : 'A real cabinet, minister by minister'}</h2>
      <p>{he
        ? 'צילומי ארכיון של השרים שמהם מרכיבים את הממשלה במשחק. בעמוד הממשלה יש כרטיס לכל אחד: התפקידים והתאריכים עם המקורות, ומה המשחק עושה איתו.'
        : 'Archival photographs of the ministers you build the government from. The Cabinet page has a card for each: the offices and dates with their sources, and what the game does with them.'}</p>
    </div>
    <div class="cab-strip">
      {ministers.map((p) => (
        <div class="cab-card">
          <PersonPortrait person={p} lang={lang} sizes="(min-width: 76rem) 14rem, 45vw" />
          <p class="cab-name"><a href={`${href(lang, 'cabinet')}#${p.id}`}>{he ? p.name_he : p.name}</a>
            <span class="cab-office">{he && !p.terms[0].title.he ? <span lang="en" dir="ltr">{p.terms[0].title.en}</span> : (he ? p.terms[0].title.he : p.terms[0].title.en)}</span></p>
        </div>
      ))}
    </div>
    <p class="cab-more"><a class="btn" href={href(lang, 'cabinet')}>{he ? `כל ${cabinetCount} נושאי המשרה` : `All ${cabinetCount} office holders`}</a></p>
  </div></section>

  <section class="concept-band seam" aria-labelledby="target">
    <div class="wrap section-head">
      <span class="label label-concept">{t(lang, 'label.concept')}</span>
      <h2 id="target" class="plaque">{he ? 'המראה שאליו אנחנו שואפים' : 'The look we are building toward'}</h2>
      <p>{he
        ? 'אמנות קונספט שנוצרה בבינה מלאכותית: יעד חזותי, לא הגרסה הנוכחית. יש בה דברים שאין במשחק. את המשחק עצמו רואים בצילומים שלמעלה.'
        : 'Concept art made with AI: a visual target, not the current build. It shows things the game does not have. The game itself is in the captures above.'}</p>
    </div>
    <Figure item={target} lang={lang} sizes="100vw" widths={[800, 1200, 1600, 2400]} class="band-figure" />
  </section>

  <section class="section promo seam" aria-labelledby="promo"><div class="wrap">
    <div class="section-head">
      <span class="label label-cinematic">{t(lang, 'label.cinematic')}</span>
      <h2 id="promo" class="plaque">{he ? 'הטריילר' : 'The trailer'}</h2>
      <p>{he
        ? 'סיפור על התקופה שנוצר בכלי וידאו של בינה מלאכותית מאמנות הקונספט שלנו. זה אינו צילום מהמשחק: את המשחק עצמו רואים בצילומים שלמעלה ובעמוד המדיה.'
        : 'A story about the era, made with AI video tools from our concept art. It is not gameplay: the game itself is in the captures above and on the Media page.'}</p>
    </div>
    <VideoFacade video={trailer} lang={lang} />
  </div></section>

  <section class="section band-grain" aria-labelledby="next"><div class="wrap">
    <div class="split">
      <div class="prose">
        <span class="eyebrow">{he ? 'לאן זה הולך' : 'Where it is going'}</span>
        <h2 id="next" class="plaque">{he ? 'עיצוב חדש, עדיין בעבודה' : 'A new design, still in progress'}</h2>
        {he ? (
          <>
            <p>מסמך עיצוב המשחק של הבעלים, GDD v0.1 מ־12 באוקטובר 2026, הוא העיצוב המחייב. הוא מתאר תורות חודשיים, יחידות, ערים, עבודת חלוצים ושלוש מטרות לשנים 1948 עד 1951. רבים מהכללים בו עדיין מסומנים כפתוחים, ובגרסה 0.1.0 הם לא קיימים.</p>
            <p>מאז 15 באוקטובר 2026 המשחק שבקוד המקור משוחק בתורות החודשיים של ה־GDD. שאר החלקים נבנים עכשיו, שלב אחר שלב.</p>
          </>
        ) : (
          <>
            <p>The design of record is the owner’s game design document, GDD v0.1 of 12 October 2026. It describes monthly turns, units, cities, pioneer work and three objectives for 1948 to 1951. Many of its rules are still marked open, and the 0.1.0 build does not have them.</p>
            <p>Since 15 October 2026 the game in the source code plays the GDD’s monthly turns. The rest is being built phase by phase.</p>
          </>
        )}
        <p><a href={`${REPO}/blob/main/docs/GDD.md`}>{he ? 'מסמך העיצוב (GDD, באנגלית)' : 'The design document (GDD)'}</a></p>
      </div>
      <div class="panel roadmap">
        <span class="eyebrow">{he ? 'מפת הדרכים' : 'Roadmap'}</span>
        <h3>{he ? 'ה־MVP של 1948 עד 1951' : 'The 1948 to 1951 MVP'}</h3>
        <ol class="phases">
          <li class="ph ph-done"><span class="ph-mark" aria-hidden="true"></span>
            <span class="ph-what">{t(lang, 'version')}</span><span class="ph-state">{stateWord('done')}</span></li>
          {phases.map((p) => (
            <li class={`ph ph-${p.state}`}><span class="ph-mark" aria-hidden="true"></span>
              <span class="ph-what"><span class="ph-n">{he ? `שלב ${p.n}` : `Phase ${p.n}`}</span> · {p.what.map((w) => w.href ? <a href={w.href}>{w.text}</a> : w.text)}</span>
              <span class="ph-state">{p.state === 'now' ? p.status : stateWord(p.state)} · <a href={p.url}>{p.issue}</a></span></li>
          ))}
        </ol>
        <p class="muted ph-note">{he ? 'מתוך טבלת מפת הדרכים ב־README. מפת הדרכים אינה קובעת תאריכים.' : 'From the roadmap table in the README. The roadmap sets no dates.'}
          {' '}<a href={`${REPO}/issues/374`}>#374</a></p>
      </div>
    </div>
  </div></section>

  <section class="section honest" aria-labelledby="honest"><div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{he ? 'בגלוי' : 'In the open'}</span>
      <h2 id="honest" class="plaque">{he ? 'מה אמיתי ומה לא' : 'What is real and what is not'}</h2>
    </div>
    <div class="cards3">
      <div class="panel">
        <h3>{he ? 'קודם המשחק האמיתי' : 'The real build first'}</h3>
        <p>{he
          ? 'כל תמונה וכל סרטון באתר אומרים מה הם: צילום מתוך המשחק עם הגרסה והתאריך, אמנות קונספט שנוצרה בבינה מלאכותית, או פרומו קולנועי שנוצר בבינה מלאכותית ואינו צילום מהמשחק.'
          : 'Every image and video on this site says what it is: an in-engine capture with its build and date, concept art made with AI, or a cinematic promo made with AI that is not gameplay.'}</p>
        <a href={href(lang, 'media')}>{t(lang, 'nav.media')}</a>
      </div>
      <div class="panel">
        <h3>{he ? 'מקורות ומסגור' : 'Sources and framing'}</h3>
        <p>{he
          ? 'לכל אירוע, שר, תאריך ונתון היסטורי במשחק יש מקורות; ערכי האיזון של המשחק אינם עובדות. המסגור ישראלי, והאתר אומר זאת. עדיין אף היסטוריון לא בדק את המשחק; בדיקה כזו מתוכננת לאבן הדרך M4.'
          : 'Every event, minister, date and historical figure in the game cites its sources; game-balance values do not. The framing is Israeli, and the site says so. No historian has reviewed the game yet; that is planned for M4.'}</p>
        <a href={href(lang, 'history/sources')}>{t(lang, 'nav.sources')}</a>
      </div>
      <div class="panel">
        <h3>{he ? 'בינה מלאכותית' : 'AI use'}</h3>
        <p>{he
          ? 'הקוד, אמנות הקונספט והטריילר הקולנועי נעשו בסיוע נרחב של בינה מלאכותית. דבר אינו נוצר בזמן אמת במהלך המשחק.'
          : 'The code, the concept art and the cinematic trailer were made with heavy AI assistance. Nothing is generated live while you play.'}</p>
        <a href={href(lang, 'how-we-make-it')}>{t(lang, 'nav.how')}</a>
      </div>
    </div>
  </div></section>

  <section class="section band-grain closing" aria-labelledby="join"><div class="wrap">
    <h2 id="join" class="plaque">{he ? 'להשתתף' : 'Take part'}</h2>
    <p class="muted prose">{he
      ? 'שאלות ורעיונות נכנסים לדיונים ב־GitHub, ובאגים וטעויות היסטוריות לרשימת הבעיות. מתכנתים, היסטוריונים, אמנים, מעצבי משחק, כותבים ומתרגמים מוזמנים.'
      : 'Questions and ideas go in GitHub Discussions; bugs and historical errors go in the issue tracker. Programmers, historians, artists, game designers, writers and translators are welcome.'}</p>
    <div class="btn-row">
      <a class="btn btn-primary" href={href(lang, 'play')}>{t(lang, 'cta.play')}</a>
      <a class="btn" href={href(lang, 'contribute')}>{t(lang, 'nav.contribute')}</a>
      <a class="btn" href={`${REPO}/discussions`}>{he ? 'דיונים' : 'Discussions'}</a>
      <a class="btn" href={`${REPO}/issues/new?template=historical_accuracy.yml`}>{he ? 'דיווח על טעות היסטורית' : 'Report a historical error'}</a>
    </div>
  </div></section>

</Layout>

