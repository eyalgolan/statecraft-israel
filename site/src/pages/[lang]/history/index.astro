---
// History first, then the mechanics: every event in content/events/, in the game's order, with the game's own sourced
// text, its sources and the decision it puts to the player. Nothing on this page is written for the website.
import fs from 'node:fs';
import path from 'node:path';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import MediaLabel from '../../../components/MediaLabel.astro';
import { type Lang, languages, href, t, formatDate, repoFile } from '../../../i18n/ui';
import { events, eventPhotos, repoRoot } from '../../../lib/repo';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const he = lang === 'he';

const photoFiles = import.meta.glob<{ default: ImageMetadata }>('../../../../../unity/Assets/UI/EventImages/*.jpg', { eager: true });
const photoByFile = new Map(Object.entries(photoFiles).map(([p, m]) => [p.split('/').pop()!, m.default]));
const photos = eventPhotos();
const list = events();
const years = [...new Set(list.map((e) => e.from.slice(0, 4)))];

// The two lines the game's start screen quotes, checked word for word against the repository's copies of the
// Declaration (docs/sources/declaration-1948), as StartScreenTests does in the game.
const declaration = {
  he: ['…אנו מכריזים בזאת על הקמת מדינה יהודית בארץ־ישראל, היא מדינת ישראל.', 'בעיר תל־אביב, היום הזה, ערב שבת, ה׳ אייר תש״ח, 14 במאי 1948.'],
  en: ['…HEREBY DECLARE THE ESTABLISHMENT OF A JEWISH STATE IN ERETZ-ISRAEL, TO BE KNOWN AS THE STATE OF ISRAEL.', 'IN THE CITY OF TEL-AVIV, ON THIS SABBATH EVE, THE 5TH DAY OF IYAR, 5708 (14TH MAY, 1948).'],
};
for (const l of ['he', 'en'] as const) {
  const src = fs.readFileSync(path.join(repoRoot, `docs/sources/declaration-1948/${l}.txt`), 'utf8');
  for (const line of declaration[l]) {
    if (!src.includes(line.replace(/^…/, ''))) throw new Error(`history: declaration line not found in ${l}.txt: ${line}`);
  }
}

const host = (u: string) => { try { const x = new URL(u); return x.hostname.replace(/^www\./, '') + decodeURIComponent(x.pathname).replace(/\/$/, ''); } catch { return u; } };
const yearCount = (y: string) => list.filter((e) => e.from.startsWith(y)).length;
// The year banner: the first archival photograph of that year's events, darkened under the numeral, with its label
// and credit like every other photograph on the page.
const yearBanner = (y: string) => {
  for (const e of list.filter((x) => x.from.startsWith(y))) {
    const ph = photos.get(e.id);
    const img = ph && photoByFile.get(ph.file);
    if (ph && img) return { ph, img };
  }
  return undefined;
};
const sensitiveCount = list.filter((e) => e.status === 'sensitivity-reviewed').length;
---
<Layout lang={lang} page="history" title={t(lang, 'nav.history')}
  description={he ? 'כל האירועים ההיסטוריים במשחק, 1948 עד 1951, עם המקורות שלהם וההחלטה שהמשחק מציב.' : 'Every historical event in the game, 1948 to 1951, with its sources and the decision the game puts to the player.'}>
  <div class="wrap page">
    <header class="page-head">
      <span class="eyebrow">{t(lang, 'nav.history')}</span>
      <h1>{he ? '1948 עד 1951, אירוע אחר אירוע' : '1948 to 1951, event by event'}</h1>
      <p>{he
        ? `העמוד מציג את ${list.length} האירועים ההיסטוריים שבמשחק, לפי הסדר שבו השחקן פוגש אותם. בכל אירוע מופיע קודם מה שקרה, בטקסט של המשחק עצמו ועם המקורות שלו, ואחר כך ההחלטה שהמשחק מציב. הטקסטים והמקורות נלקחים כמו שהם מתיקיית content במאגר, ושמות התפקידים ממולאים בהם.`
        : `This page lists the ${list.length} historical events in the game, in the order the player meets them. Each one shows first what happened, in the game's own text with its sources, then the decision the game puts to the player. The text and the sources are taken as they are from the repository's content folder, with the office names filled in.`}</p>
    </header>

    <section class="opening" aria-labelledby="opening">
      <h2 id="opening" class="visually-hidden">{he ? 'נקודת הפתיחה' : 'The starting point'}</h2>
      <div class="declaration panel">
        <p class="decl-he" lang="he" dir="rtl">{declaration.he[0]}</p>
        <p class="decl-en" lang="en" dir="ltr">{declaration.en[0]}</p>
        <p class="decl-he" lang="he" dir="rtl">{declaration.he[1]}</p>
        <p class="decl-en" lang="en" dir="ltr">{declaration.en[1]}</p>
        <p class="decl-source">{he
          ? 'מתוך ההכרזה על הקמת מדינת ישראל (עיתון רשמי מס׳ 1, 14 במאי 1948) ותרגומה הרשמי לאנגלית. אלה השורות שמסך הפתיחה של המשחק מצטט.'
          : 'From the Declaration of the Establishment of the State of Israel (Official Gazette No. 1, 14 May 1948) and its official English translation. These are the lines the game’s start screen quotes.'}
          {' '}<a href={repoFile('docs/sources/declaration-1948/he.txt')}>{he ? 'הנוסח המלא' : 'Full text'}</a></p>
      </div>
      <div class="prose">
        <p>{he
          ? 'המשחק מתחיל למחרת, ב־15 במאי 1948, ואתם ראש הממשלה.'
          : 'The game starts the next day, on 15 May 1948, with you as prime minister.'}</p>
        <p class="note">{he
          ? 'המשחק עוסק במלחמה, בטרור ובשואה כאירועים היסטוריים. המסגור שלו ישראלי. כל צילום ארכיון בעמוד הזה הוא צילום אמיתי עם קרדיט ורישיון; אין בעמוד תמונות שנוצרו בבינה מלאכותית.'
          : 'The game deals with war, terror and the Holocaust as historical events. Its framing is Israeli. Every archival photograph on this page is a real photograph with its credit and licence; there are no AI-generated images on this page.'}
          {' '}<a href={href(lang, 'history/approach')}>{he ? 'איך המשחק מתייחס להיסטוריה' : 'How the game treats history'}</a></p>
        {he && <p class="note">{t(lang, 'history.en-only')} {'כותרות האירועים, הטקסטים והאפשרויות מוצגים כאן כפי שהם מופיעים במשחק.'}</p>}
      </div>
    </section>

    <div class="chron">
    {/* Proposal v2: a sticky year rail (a bar on phones) and one collapsible list per year, so the page is no longer one
        long list. 1948 starts open; a link to a year or an event opens its list (script below, and the browser's own
        details revealing for find-in-page). */}
    <nav class="years" aria-label={he ? 'שנים' : 'Years'}>
      {years.map((y) => <a href={`#y${y}`} data-year={y}><span class="ry">{y}</span> <span class="rc">{yearCount(y)}</span></a>)}
      <a href="#how" class="r-how">{he ? 'איך זה עובד במשחק' : 'How it works in the game'}</a>
    </nav>

    <div class="chron-main">
    {years.map((y, i) => {
      const banner = yearBanner(y);
      return (
      <section class="year" aria-labelledby={`y${y}`} data-year={y}>
        <header class="year-card seam">
          {banner && (
            <figure class="media year-banner" data-kind="archival">
              <div class="media-frame">
                <MediaLabel lang={lang} kind="archival" />
                <Picture src={banner.img} alt="" formats={['avif']} fallbackFormat="webp" widths={[800, 1200]} quality={55}
                  sizes="(min-width: 76rem) 64rem, 100vw" loading={i === 0 ? 'eager' : 'lazy'} />
              </div>
              <figcaption lang="en" dir="ltr">{banner.ph.credit} · <a href={banner.ph.commons}>Wikimedia&nbsp;Commons</a></figcaption>
            </figure>
          )}
          <div class="year-text">
            <h2 id={`y${y}`} class="year-title plaque plaque-center">{y}</h2>
            <p class="year-count">{he ? `${yearCount(y)} אירועים` : `${yearCount(y)} events`}</p>
          </div>
        </header>
        <details class="year-events" open={i === 0}>
          <summary><span class="when-closed">{he ? `להצגת ${yearCount(y)} האירועים של ${y}` : `Show the ${yearCount(y)} events of ${y}`}</span><span class="when-open">{he ? `להסתרת האירועים של ${y}` : `Hide the events of ${y}`}</span></summary>
        {list.filter((e) => e.from.startsWith(y)).map((e) => {
          const ph = photos.get(e.id);
          const img = ph && photoByFile.get(ph.file);
          return (
            <article class="event" id={e.id}>
              {img && ph && (
                <figure class="media event-photo" data-kind="archival">
                  <div class="media-frame">
                    <MediaLabel lang={lang} kind="archival" />
                    <Picture src={img} alt={ph.alt} lang="en" formats={['avif']} fallbackFormat="webp" widths={[400, 720]}
                      sizes="(min-width: 60rem) 26rem, 100vw" loading="lazy" />
                  </div>
                  <figcaption lang="en" dir="ltr">{ph.credit} · <a href={ph.commons}>Wikimedia&nbsp;Commons</a></figcaption>
                </figure>
              )}
              <div class="event-body">
                <p class="event-date">{t(lang, 'date.window')}{he ? '' : ' '}<time datetime={e.from}>{formatDate(lang, e.from)}</time></p>
                <h3 lang="en" dir="ltr">{e.title}</h3>
                <p class="event-text" lang="en" dir="ltr">{e.text}</p>
                <div class="choice">
                  <h4>{t(lang, 'history.choice')}</h4>
                  <ul lang="en" dir="ltr">
                    {e.options.map((o) => (
                      <li class:list={{ historical: o.historical }}>
                        {o.text}
                        {o.historical && <span class="tag" lang={lang} dir={he ? 'rtl' : undefined}>{t(lang, 'history.historical')}</span>}
                      </li>
                    ))}
                  </ul>
                </div>
                <details class="sources">
                  <summary>{t(lang, 'history.sources')} ({e.sources.length}) · {t(lang, 'history.status')}: {t(lang, `history.status.${e.status}` as 'history.status.fact-checked')}</summary>
                  <ul>
                    {e.sources.map((s) => (
                      <li><a href={s.url} class="ltr">{host(s.url)}</a>{s.checked && <span class="muted"> · {he ? 'נבדק ב־' : 'checked '}{formatDate(lang, s.checked)}</span>}</li>
                    ))}
                  </ul>
                  <p><a href={repoFile(`content/events/${e.id}.yaml`)}>{he ? 'קובץ האירוע במאגר' : 'The event file in the repository'}</a></p>
                </details>
              </div>
            </article>
          );
        })}
        </details>
      </section>
      );
    })}
    </div>
    </div>

    <section class="how prose" aria-labelledby="how">
      <h2 id="how">{he ? 'איך זה עובד במשחק' : 'How it works in the game'}</h2>
      {he ? (
        <>
          <p>כל אירוע נפתח בחלון תאריכים. כשהתור מגיע לחלון, המשחק מציג את הכרטיס לשר האחראי, והשחקן בוחר אפשרות. האפשרות שסומנה כאן "מה שקרה בפועל" היא הבחירה ההיסטורית; האפשרויות האחרות הן חלופות שעמדו על הפרק או הנחות של עיצוב המשחק, וההערות בקובץ האירוע מציינות איפה מדובר בהנחה.</p>
          <p>לכל אפשרות יש השפעות על מדדי המשחק, כמו הביטחון, המורל והתמיכה הבינלאומית. הערכים האלה הם איזון של משחק ולא עובדות היסטוריות, ולוח "למה?" מראה בכל תור מה השתנה ומה גרם לכך.</p>
          <p>{`כל האירועים נבדקו מול המקורות שלהם. ${sensitiveCount} אירועים עם תגיות רגישות (מלחמה ונפגעים, טרור, שואה) עברו גם בדיקת רגישות, וכלי הבנייה מסרבים לארוז גרסה לשיתוף בלעדיה. שום היסטוריון עדיין לא בדק את המשחק; בדיקה כזו מתוכננת לאבן הדרך M4.`}</p>
          <p>מכיוון ש־GDD v0.1 הוא העיצוב המחייב עכשיו, המנגנון הזה ישתנה: לפי ה־GDD, השלמת מטרה תעלה כרטיס על האירוע ההיסטורי שקשור אליה, עם התאריך האמיתי שלו.</p>
        </>
      ) : (
        <>
          <p>Each event opens in a date window. When a turn reaches the window, the game puts the card to the minister in charge, and the player picks an option. The option marked “What happened” here is the historical choice; the others are alternatives that were on the table or design assumptions, and the comments in the event file note where an option is an assumption.</p>
          <p>Each option has effects on the game’s indicators, such as security, morale and international support. Those values are game balance, not historical facts, and the “Why?” panel shows each turn what changed and why.</p>
          <p>{`Every event has been checked against its sources. ${sensitiveCount} events with sensitive tags (war casualties, terror, the Holocaust) have also had a sensitivity review, and the build tools refuse to package a shareable build without it. No historian has reviewed the game yet; that is planned for M4.`}</p>
          <p>Because GDD v0.1 is now the design of record, this will change: under the GDD, completing an objective brings up a card about the historical event tied to it, with its real date.</p>
        </>
      )}
      <p><a href={href(lang, 'history/sources')}>{t(lang, 'nav.sources')}</a> · <a href={href(lang, 'history/approach')}>{t(lang, 'nav.approach')}</a></p>
    </section>
  </div>
</Layout>

<style>
  .opening { display: grid; gap: 2rem; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: start; margin-block-end: 2.5rem; }
  @media (max-width: 56rem) { .opening { grid-template-columns: 1fr; } }
  .declaration p { margin-block-end: 0.35rem; }
  .decl-he { font-family: var(--serif-he); font-size: 1.3rem; line-height: 1.6; text-align: right; }
  .decl-en { font-family: var(--serif); font-size: 0.85rem; letter-spacing: 0.05em; color: var(--gold-light); margin-block-end: 1.1rem !important; text-align: left; }
  .decl-source { font-size: 0.9rem; color: var(--ink-dim); margin-block-start: 1rem !important; }
  .note { color: var(--ink-dim); font-size: 0.95em; border-block-start: 1px solid var(--gold-faint); padding-block-start: 0.8rem; }
  .years { position: sticky; inset-block-start: var(--header-h); z-index: 5; display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; padding-block: 0.6rem; background: var(--navy-deep); border-block: 1px solid var(--gold-faint); margin-block-end: 1rem; }
  .years a { color: var(--gold-light); text-decoration: none; font-weight: 600; }
  .years .rc { color: var(--ink-dim); font-weight: 400; font-size: 0.85em; }
  .years a.on .ry { color: var(--ink); }
  .years a.on { box-shadow: inset 0 -2px 0 var(--gold); }
  /* Desktop: the rail stands beside the years, like the game's left column. */
  @media (min-width: 72rem) {
    .chron { display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); gap: 2.5rem; align-items: start; }
    .years { flex-direction: column; flex-wrap: nowrap; gap: 0; padding: 0; border-block: 0; border-inline-end: 1px solid var(--gold-faint); inset-block-start: calc(var(--header-h) + 1.5rem); margin-block-start: 3rem; background: none; }
    .years a { display: flex; justify-content: space-between; align-items: baseline; padding: 0.55rem 1rem 0.55rem 0; padding-inline: 0 1rem; border-block-end: 1px solid var(--navy-line); }
    .years .ry { font-size: 1.6rem; line-height: 1; }
    .years a.on { box-shadow: inset -3px 0 0 var(--gold); }
    [dir='rtl'] .years a.on { box-shadow: inset 3px 0 0 var(--gold); }
    .years .r-how { font-size: 0.9rem; font-weight: 500; border-block-end: 0; }
  }
  .year-events > summary { cursor: pointer; list-style: none; text-align: center; padding: 0.7rem 1rem; margin-block: 0.75rem 0.5rem; border: 1px solid var(--gold-dim); color: var(--gold-light); font-weight: 600; background: var(--navy-solid); }
  .year-events > summary::-webkit-details-marker { display: none; }
  .year-events > summary:hover { border-color: var(--gold); }
  .year-events[open] .when-closed, .year-events:not([open]) .when-open { display: none; }
  /* Proposal: each year is a title card, Civ VI's expansion lockup applied to time: a large numeral on the grain
     texture, with the plaque under it and a gilt seam above. */
  /* Proposal v2: the year card is a picture band: the year's first archival photograph, darkened, under the numeral. */
  .year-card { margin-block: 3rem 0; text-align: center; display: grid; }
  .year-card > * { grid-area: 1 / 1; }
  .year-banner { margin: 0; }
  .year-banner .media-frame { block-size: clamp(12rem, 22vw, 17rem); }
  .year-banner .media-frame :global(picture), .year-banner .media-frame :global(img) { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; object-position: 50% 35%; filter: grayscale(0.2) brightness(0.55); }
  .year-banner .media-frame::after { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 45% 70% at 50% 50%, rgba(9, 14, 26, 0.88), rgba(9, 14, 26, 0.45) 75%, rgba(9, 14, 26, 0.3)); }
  .year-banner figcaption { position: absolute; inset-block-end: 0.35rem; inset-inline-end: 0.6rem; font-size: 0.72rem; padding: 0.1rem 0.4rem; background: rgba(9, 14, 26, 0.85); color: var(--ink-dim); }
  .year-card { position: relative; }
  .year-text { align-self: center; position: relative; z-index: 2; padding: 1.5rem 1rem; pointer-events: none; }
  .year-card:not(:has(.year-banner)) .year-text { background-color: var(--navy-solid); background-image: var(--grain); border: 1px solid var(--gold-faint); }
  .year-title { font-size: clamp(2.8rem, 2rem + 3vw, 4.4rem); color: var(--gold-light); margin: 0; letter-spacing: 0.08em; line-height: 1; }
  .year-count { margin: 0.6rem 0 0; color: var(--ink); font-size: 0.95rem; }
  :lang(he) .year-title { letter-spacing: 0; }
  .event { display: grid; grid-template-columns: minmax(0, 26rem) minmax(0, 1fr); gap: clamp(1rem, 3vw, 2rem); padding-block: 1.75rem; border-block-end: 1px solid var(--navy-line); }
  .event:not(:has(.event-photo)) .event-body { grid-column: 2; }
  @media (max-width: 60rem) {
    .event { grid-template-columns: 1fr; }
    .event:not(:has(.event-photo)) .event-body { grid-column: auto; }
  }
  .event-photo figcaption { font-size: 0.8rem; }
  .event-date { color: var(--gold); font-size: 0.95rem; margin-block-end: 0.2rem; }
  .event h3 { margin-block-end: 0.5rem; }
  .event-text { max-inline-size: var(--measure); }
  .choice { background: var(--navy-solid); border: 1px solid var(--gold-dim); border-radius: 2px; padding: 0.8rem 1.1rem; margin-block: 1rem; max-inline-size: var(--measure); }
  .choice h4 { font-size: 0.95rem; color: var(--gold); margin-block-end: 0.5rem; padding-block-end: 0.4rem; border-block-end: 1px solid var(--gold-faint); }
  .choice ul { margin: 0; padding-inline-start: 1.1rem; }
  .choice li { margin-block: 0.25rem; }
  .tag { display: inline-block; margin-inline-start: 0.5rem; font-size: 0.78rem; font-weight: 600; padding: 0.05em 0.5em; border: 1px solid var(--gold-dim); color: var(--gold-light); border-radius: 2px; }
  .sources summary { cursor: pointer; color: var(--ink-dim); font-size: 0.95rem; }
  .sources ul { font-size: 0.9rem; margin-block: 0.6rem; padding-inline-start: 1.1rem; overflow-wrap: anywhere; }
  .sources p { font-size: 0.9rem; }
  .how { margin-block-start: 3rem; }
  .event-photo :global(img) { inline-size: 100%; }
</style>

<script>
  // Open a year's list when a link targets the year or an event inside it, and mark the year in view on the rail.
  const openFor = (id: string) => {
    const el = id && document.getElementById(id);
    if (!el) return;
    const sec = el.closest<HTMLElement>('section.year');
    const d = sec?.querySelector<HTMLDetailsElement>('details.year-events');
    if (d && !d.open) { d.open = true; if (el.closest('details') === d) el.scrollIntoView(); }
  };
  openFor(decodeURIComponent(location.hash.slice(1)));
  window.addEventListener('hashchange', () => openFor(decodeURIComponent(location.hash.slice(1))));
  const rail = new Map([...document.querySelectorAll<HTMLAnchorElement>('.years a[data-year]')].map((a) => [a.dataset.year!, a]));
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) if (en.isIntersecting) {
        for (const a of rail.values()) a.classList.remove('on');
        rail.get((en.target as HTMLElement).dataset.year!)?.classList.add('on');
      }
    }, { rootMargin: '-45% 0px -50% 0px' });
    document.querySelectorAll('section.year').forEach((s) => io.observe(s));
  }
</script>
