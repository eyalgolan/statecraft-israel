---
// The Cabinet: one card for everyone who held an office in the game's years, in the Civ VI leader-post order (portrait,
// history, then "In the game"). Everything is read from content/people.yaml, offices.yaml and parties.yaml, the game's
// own portraits and ASSETS.portraits.yaml. No quote appears: content/ holds none, so each card opens with a tagline
// built from its sourced offices and dates. Portraits are archival photographs only, never generated.
import Layout from '../../layouts/Layout.astro';
import PersonPortrait from '../../components/PersonPortrait.astro';
import { type Lang, languages, href, t, formatDate, repoFile } from '../../i18n/ui';
import { cabinet, events, type Person, type Term, type Named } from '../../lib/repo';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const he = lang === 'he';

const people = cabinet();
const evs = events();

// A name in the page's language; where content/ has no Hebrew form, the English, marked as English.
const hasHe = (n: Named) => !!n.he;
const label = (n: Named) => (he && n.he) || n.en;
const year = (iso?: string) => iso?.slice(0, 4);
// A year range is isolated left to right (U+2066 ... U+2069), or Hebrew text shows 1948–1952 as 1952–1948. One year
// is written once.
const span = (tm: Term) => !tm.to ? (he ? `מ־${year(tm.from)}` : `from ${year(tm.from)}`)
  : year(tm.from) === year(tm.to) ? year(tm.from)! : `\u2066${year(tm.from)}–${year(tm.to)}\u2069`;
// The tagline: the offices held in the game's years, with their years. Built from the sourced terms, never a quote.
const tagline = (p: Person) => {
  // Terms split only by a change of list are one stretch in office here: join them before writing the years.
  const runs: Term[] = [];
  for (const tm of [...p.terms].sort((a, b) => a.from.localeCompare(b.from))) {
    const prev = runs.find((r) => r.office === tm.office && r.to === tm.from);
    if (prev) prev.to = tm.to; else runs.push({ ...tm });
  }
  const order = new Map(p.terms.map((t, i) => [t.office, i]));
  runs.sort((a, b) => order.get(a.office)! - order.get(b.office)! || a.from.localeCompare(b.from));
  const seen = new Map<string, { t: Term; spans: string[] }>();
  for (const tm of runs) {
    const k = label(tm.title);
    const e = seen.get(k) ?? { t: tm, spans: [] };
    if (!e.spans.includes(span(tm))) e.spans.push(span(tm));
    seen.set(k, e);
  }
  return [...seen.values()];
};
const inGame = (p: Person) => evs.filter((e) => e.office && p.terms.some((tm) => tm.office === e.office && e.from >= tm.from && (!tm.to || e.from < tm.to)));
const host = (u: string) => { try { const x = new URL(u); return x.hostname.replace(/^www\./, '') + decodeURIComponent(x.pathname).replace(/\/$/, ''); } catch { return u; } };
const groups = [
  { id: 'government', title: he ? 'הממשלה' : 'The government', note: he ? 'ראש הממשלה והשרים, מהממשלה הזמנית ועד הממשלה השלישית.' : 'The Prime Minister and the ministers, from the Provisional Government to the Third Government.' },
  { id: 'state', title: he ? 'הנשיא והצבא' : 'Head of state and the army', note: he ? 'נושאי משרה שהמשחק מציג ואינם חברי ממשלה.' : 'Office holders the game shows who were not members of the government.' },
  { id: 'deputy', title: he ? 'סגני שרים' : 'Deputy ministers', note: he ? 'תארים היסטוריים בלבד: במשחק אין להם סמכויות.' : 'Historical titles only: they carry no powers in the game.' },
] as const;
const statusText = (s: string) => s === 'fact-checked' || s === 'sensitivity-reviewed' ? t(lang, `history.status.${s}` as 'history.status.fact-checked') : s;
---
<Layout lang={lang} page="cabinet" title={t(lang, 'nav.cabinet')}
  description={he ? 'כל מי שכיהן בתפקיד בשנים של המשחק, 1948 עד 1951: צילום ארכיון, התפקידים והתאריכים עם המקורות, ומה הם עושים במשחק.' : 'Everyone who held office in the game’s years, 1948 to 1951: an archival photograph, the offices and dates with their sources, and what they do in the game.'}>
  <div class="wrap page">
    <header class="page-head">
      <span class="eyebrow">{t(lang, 'nav.cabinet')}</span>
      <h1>{he ? 'נושאי המשרה, 1948 עד 1951' : 'Office holders, 1948 to 1951'}</h1>
      <p>{he
        ? `${people.length} האנשים שכיהנו בתפקיד בשנים של המשחק. בכל כרטיס מופיע קודם מה שקרה, התפקידים והתאריכים עם המקורות שלהם, ואחר כך מה שהמשחק עושה איתם. הנתונים נלקחים כמו שהם מתיקיית content במאגר. הצילומים הם צילומי ארכיון בנחלת הכלל או ברישיון פתוח, עם הקרדיט שהרישיון דורש; צילומים שהרישיון שלהם עדיין בבדיקה אינם מוצגים בינתיים. אין בעמוד הזה תמונות שנוצרו בבינה מלאכותית.`
        : `The ${people.length} people who held office in the game’s years. Each card shows first what happened, the offices and dates with their sources, then what the game does with them. The data is taken as it is from the repository’s content folder. The portraits are archival photographs in the public domain or under an open licence, with the credit the licence asks for; photographs whose licence is still being checked are not shown yet. There are no AI-generated images on this page.`}</p>
      {he && <p class="note">{'שמות התפקידים בעברית נבדקו מול המקורות על ידי סוכן בינה מלאכותית ומחכים לבדיקה של דובר עברית (#564).'}</p>}
    </header>

    <nav class="jump" aria-label={he ? 'קבוצות' : 'Groups'}>
      {groups.map((g) => people.some((p) => p.group === g.id) && <a href={`#${g.id}`}>{g.title}</a>)}
    </nav>

    {groups.map((g) => {
      const members = people.filter((p) => p.group === g.id);
      if (!members.length) return null;
      return (
        <section class="group" aria-labelledby={g.id}>
          <div class="group-head">
            <h2 id={g.id} class="plaque">{g.title}</h2>
            <p class="muted">{g.note}</p>
          </div>
          <div class="cards">
            {members.map((p) => {
              const games = inGame(p);
              return (
                <article class="minister" id={p.id}>
                  <PersonPortrait person={p} lang={lang} sizes="13rem" />
                  <div class="body">
                    <p class="tagline">{tagline(p).map((e, i) => <>{i > 0 && ' · '}{he && !hasHe(e.t.title) ? <span lang="en" dir="ltr">{e.t.title.en}</span> : label(e.t.title)}, {e.spans.join(he ? ' ו־' : ' and ')}</>)}</p>
                    <h3>{he ? p.name_he : p.name}</h3>
                    <p class="alt-name" lang={he ? 'en' : 'he'} dir={he ? 'ltr' : 'rtl'}>{he ? p.name : p.name_he}</p>
                    <dl class="facts">
                      {/* Neutral Hebrew labels (לידה, פטירה): content/ records no gender, and the cards include women. */}
                      <dt>{he ? 'לידה' : 'Born'}</dt><dd>{formatDate(lang, p.born)}</dd>
                      {p.died && <><dt>{he ? 'פטירה' : 'Died'}</dt><dd>{formatDate(lang, p.died)}</dd></>}
                      {p.party && <><dt>{he ? 'מפלגה' : 'Party'}</dt><dd>{he && !hasHe(p.party) ? <span lang="en" dir="ltr">{p.party.en}</span> : label(p.party)}</dd></>}
                    </dl>
                    <h4>{he ? 'בתפקיד' : 'In office'}</h4>
                    <ul class="terms">
                      {p.terms.map((tm) => (
                        <li><span class="t-title">{he && !hasHe(tm.title) ? <span lang="en" dir="ltr">{tm.title.en}</span> : label(tm.title)}</span>{' '}<span class="t-dates">{formatDate(lang, tm.from)}{' – '}{tm.to ? formatDate(lang, tm.to) : (he ? 'אחרי 1951' : 'beyond 1951')}</span>
                          {tm.party && (!p.party || tm.party.en !== p.party.en) && <span class="t-party">{he ? ' · ברשימת ' : ' · for '}{he && !hasHe(tm.party) ? <span lang="en" dir="ltr">{tm.party.en}</span> : label(tm.party)}</span>}</li>
                      ))}
                    </ul>
                    <details class="sources">
                      <summary>{t(lang, 'history.sources')} ({new Set([...p.bioSources, ...p.terms.flatMap((tm) => tm.sources)].map((s) => s.url)).size}) · {t(lang, 'history.status')}: {statusText(p.status)}</summary>
                      <ul>
                        {[...new Map([...p.bioSources, ...p.terms.flatMap((tm) => tm.sources)].map((s) => [s.url, s])).values()].map((s) => (
                          <li><a href={s.url} class="ltr">{host(s.url)}</a></li>
                        ))}
                      </ul>
                      <p><a href={repoFile('content/people.yaml')}>{he ? 'קובץ האנשים במאגר' : 'The people file in the repository'}</a></p>
                    </details>
                    <div class="ingame">
                      <h4>{he ? 'במשחק' : 'In the game'}</h4>
                      {games.length ? (
                        <>
                          <p>{he ? 'האירועים שהמשחק מציב לתפקיד הזה בזמן הכהונה:' : 'The events the game puts to their office while they hold it:'}</p>
                          <ul class="events" lang="en" dir="ltr">
                            {games.slice(0, 5).map((e) => <li><a href={`${href(lang, 'history')}#${e.id}`}>{e.title}</a> <span class="muted">{formatDate('en', e.from)}</span></li>)}
                          </ul>
                          {games.length > 5 && <p><a href={href(lang, 'history')}>{he ? `ועוד ${games.length - 5} בעמוד ההיסטוריה` : `and ${games.length - 5} more on the History page`}</a></p>}
                        </>
                      ) : (
                        <p>{he ? 'עדיין אין אירוע שמוצב לתפקיד הזה.' : 'No event is put to their office yet.'}</p>
                      )}
                      <p class="ratings">{he
                        ? `יכולת ${p.competence} ונאמנות ${p.loyalty} מתוך 10: ערכי איזון של המשחק, לא עובדות היסטוריות.`
                        : `Competence ${p.competence} and loyalty ${p.loyalty} out of 10: game-balance values, not historical facts.`}</p>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}
  </div>
</Layout>

<style>
  .note { color: var(--ink-dim); font-size: 0.95em; margin-block-start: 0.8rem !important; }
  .jump { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; padding-block: 0.6rem; border-block: 1px solid var(--gold-faint); margin-block-end: 1rem; }
  .jump a { color: var(--gold-light); text-decoration: none; font-weight: 600; }
  .group { padding-block: 3rem 1rem; }
  .group + .group { position: relative; }
  .group + .group::before { content: ''; position: absolute; inset-inline: 0; inset-block-start: 0; block-size: 6px; transform: translateY(-50%); background: var(--gilt-band); box-shadow: 0 1px 0 rgba(0, 0, 0, 0.6), 0 -1px 0 rgba(0, 0, 0, 0.6); }
  .group-head { max-inline-size: var(--measure); margin-block-end: 2rem; }
  .cards { display: grid; gap: clamp(1.5rem, 3vw, 2.5rem); grid-template-columns: repeat(auto-fill, minmax(min(100%, 34rem), 1fr)); }
  /* One card: the portrait in a gilt frame beside the text, like a leader screen. On the grain texture (7:1 checked). */
  .minister {
    display: grid; grid-template-columns: 13rem minmax(0, 1fr); gap: 1.4rem; align-items: start; padding: 1.4rem;
    border: 1px solid var(--gold-dim); background-color: var(--navy-solid); background-image: var(--grain);
    --ink-dim: rgb(196, 190, 176);
  }
  @media (max-width: 30rem) { .minister { grid-template-columns: 1fr; } .minister > :first-child { max-inline-size: 15rem; } }
  .t-party { color: var(--ink-dim); }
  .tagline { color: var(--gold-light); font-size: 0.9rem; font-weight: 600; margin-block-end: 0.3rem; }
  .minister h3 { font-size: clamp(1.4rem, 1.2rem + 0.6vw, 1.75rem); margin-block-end: 0.1rem; }
  .alt-name { color: var(--ink-dim); margin-block-end: 0.6rem; }
  .facts { display: grid; grid-template-columns: auto 1fr; gap: 0.1rem 0.75rem; font-size: 0.95rem; margin-block-end: 0.8rem; }
  .facts dt { color: var(--gold-light); }
  .facts dd { margin: 0; }
  .minister h4 { font-size: 0.95rem; color: var(--gold-light); margin-block: 0.6rem 0.3rem; padding-block-end: 0.25rem; border-block-end: 1px solid var(--gold-faint); }
  .terms { list-style: none; padding: 0; margin: 0 0 0.6rem; font-size: 0.95rem; }
  .terms li { margin-block: 0.15rem; }
  .t-dates { color: var(--ink-dim); white-space: nowrap; }
  .sources summary { cursor: pointer; color: var(--ink-dim); font-size: 0.9rem; }
  .sources ul { font-size: 0.85rem; padding-inline-start: 1.1rem; overflow-wrap: anywhere; }
  .sources p { font-size: 0.85rem; }
  .ingame { margin-block-start: 0.6rem; padding: 0.7rem 0.9rem; background: rgba(9, 14, 26, 0.75); border: 1px solid var(--gold-faint); font-size: 0.95rem; }
  .ingame h4 { margin-block-start: 0 !important; }
  .ingame p { margin-block-end: 0.4rem; }
  .events { margin: 0 0 0.5rem; padding-inline-start: 1.1rem; }
  .ratings { color: var(--ink-dim); font-size: 0.85rem; margin: 0 !important; }
</style>
