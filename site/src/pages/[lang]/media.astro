---
// Three galleries, kept apart and labelled: in-engine captures first, then AI concept art, then the AI cinematic promo.
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Figure from '../../components/Figure.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import { type Lang, languages, href, t } from '../../i18n/ui';
import { engine, concept, flythrough, trailer, gameplayVideo } from '../../lib/media';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const he = lang === 'he';
// The first in-engine picture is the page's LCP image on phones: preload the same AVIF set the Figure renders.
const first = engine[0];
const firstAvif = await getImage({ src: first.src, widths: [480, 800, 1200, 1600].filter((w) => w <= first.src.width), format: 'avif', quality: 68 });
const firstSizes = '(min-width: 76rem) 36rem, (min-width: 48rem) 50vw, 100vw';
---
<Layout lang={lang} page="media" title={t(lang, 'nav.media')}
  preload={[{ srcset: firstAvif.srcSet.attribute, sizes: firstSizes, type: 'image/avif' }]}
  description={he ? 'צילומים מתוך המשחק, אמנות קונספט שנוצרה בבינה מלאכותית, והטריילר הקולנועי, כל אחד עם התווית שלו.' : 'In-engine captures, AI-generated concept art and the cinematic trailer, each with its label.'}>
  <div class="wrap page">
    <header class="page-head">
      <span class="eyebrow">{t(lang, 'nav.media')}</span>
      <h1>{he ? 'תמונות ווידאו' : 'Images and video'}</h1>
      <p>{he
        ? 'שלוש גלריות נפרדות. רק הראשונה מראה את המשחק כפי שהוא היום. כל תמונה וכל סרטון נושאים תווית שאומרת מה הם, וכל קובץ רשום במאגר עם המקור והרישיון שלו.'
        : 'Three separate galleries. Only the first shows the game as it is today. Every image and video carries a label that says what it is, and every file is recorded in the repository with its source and licence.'}</p>
    </header>

    <section class="section-g" aria-labelledby="engine">
      <div class="g-head">
        <span class="label label-engine">{t(lang, 'label.engine')}</span>
        <h2 id="engine" class="plaque">{he ? 'מתוך המשחק' : 'In-engine captures'}</h2>
        <p>{he
          ? 'צילומי מסך והקלטות אמיתיים מהגרסאות של המשחק, עם הגרסה והתאריך. היישובים והעצים הם עדיין אמנות זמנית.'
          : 'Real screenshots and recordings from the game’s builds, with the build and the date. Settlements and trees are still placeholder art.'}</p>
      </div>
      <div class="gallery">
        {engine.map((item, i) => <Figure item={item} lang={lang} eager={i === 0} sizes={firstSizes} />)}
      </div>
      {gameplayVideo && (
        <div class="video-row">
          <VideoFacade video={gameplayVideo} lang={lang} sizes="(min-width: 76rem) 64rem, 100vw" />
        </div>
      )}
      <div class="video-row">
        <VideoFacade video={flythrough} lang={lang} sizes="(min-width: 76rem) 64rem, 100vw" />
      </div>
    </section>

    <section class="section-g" aria-labelledby="concept">
      <div class="g-head">
        <span class="label label-concept">{t(lang, 'label.concept')}</span>
        <h2 id="concept" class="plaque">{he ? 'אמנות קונספט' : 'Concept art'}</h2>
        <p>{he
          ? 'התמונות האלה נוצרו בבינה מלאכותית (ElevenLabs Image API: ‏GPT Image 2.5 ו־Nano Banana Pro). הן מראות את המראה שאליו אנחנו שואפים, לא את הגרסה הנוכחית, ויש בהן דברים, שנים ומסכים שאין במשחק. בשתיים מהן מופיעות דמויות של שרים אמיתיים שנוצרו בבינה מלאכותית לפי צילומים בנחלת הכלל; הן אינן צילומים, ואינן בשימוש במשחק.'
          : 'These images were made with AI (ElevenLabs Image API: GPT Image 2.5 and Nano Banana Pro). They show the look we are building toward, not the current build, and they show things, years and screens the game does not have. Two show AI likenesses of real ministers made from public-domain photographs; they are not photographs and are not used in the game.'}</p>
      </div>
      <div class="gallery">
        {concept.map((item) => <Figure item={item} lang={lang} sizes={firstSizes} />)}
      </div>
    </section>

    <section class="section-g" aria-labelledby="cinematic">
      <div class="g-head">
        <span class="label label-cinematic">{t(lang, 'label.cinematic')}</span>
        <h2 id="cinematic" class="plaque">{he ? 'פרומו קולנועי' : 'Cinematic promo'}</h2>
        <p>{he
          ? 'הטריילר נוצר בכלי וידאו של בינה מלאכותית מאמנות הקונספט שלנו. זה סיפור על התקופה, לא תצוגה מקדימה של המשחק: אין בו שום צילום מתוך המשחק.'
          : 'The trailer was made with AI video tools from our concept art. It is a story about the era, not a preview of the game: none of it is in-game footage.'}</p>
      </div>
      <div class="video-row">
        <VideoFacade video={trailer} lang={lang} sizes="(min-width: 76rem) 64rem, 100vw" />
      </div>
    </section>

    <p class="muted prose">{he ? 'איך כל אחד מהם נעשה, ובאילו כלים: ' : 'How each of these was made, and with which tools: '}<a href={href(lang, 'how-we-make-it')}>{t(lang, 'nav.how')}</a>.</p>
  </div>
</Layout>
<style>
  .section-g { padding-block: 1rem 3rem; }
  .section-g + .section-g { position: relative; padding-block-start: 3rem; }
  /* Proposal: the gilt seam between the three galleries. */
  .section-g + .section-g::before { content: ''; position: absolute; inset-inline: 0; inset-block-start: 0; block-size: 6px; transform: translateY(-50%); background: var(--gilt-band); box-shadow: 0 1px 0 rgba(0, 0, 0, 0.6), 0 -1px 0 rgba(0, 0, 0, 0.6); }
  .g-head { max-inline-size: var(--measure); margin-block-end: 1.5rem; }
  .g-head h2 { margin-block: 0.6rem 0.5rem; }
  .g-head p { color: var(--ink-dim); }
  .video-row { max-inline-size: 64rem; margin-block-start: 2.5rem; }
  /* Proposal v2: larger imagery, two pictures a row on a desktop instead of three. */
  .gallery { grid-template-columns: repeat(auto-fill, minmax(min(100%, 30rem), 1fr)); gap: clamp(1.25rem, 3vw, 2.5rem); }
</style>
