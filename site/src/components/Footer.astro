---
import { type Lang, type Page, href, otherLang, t, REPO } from '../i18n/ui';
interface Props { lang: Lang; page: Page }
const { lang, page } = Astro.props;
const other = otherLang(lang);
const links: { page: Page; key: Parameters<typeof t>[1] }[] = [
  { page: '', key: 'nav.home' }, { page: 'play', key: 'nav.play' }, { page: 'history', key: 'nav.history' },
  { page: 'history/sources', key: 'nav.sources' }, { page: 'cabinet', key: 'nav.cabinet' }, { page: 'media', key: 'nav.media' }, { page: 'devlog', key: 'nav.devlog' },
];
const links2: { page: Page; key: Parameters<typeof t>[1] }[] = [
  { page: 'contributors', key: 'nav.contributors' }, { page: 'how-we-make-it', key: 'nav.how' },
  { page: 'press', key: 'nav.press' }, { page: 'contribute', key: 'nav.contribute' }, { page: 'privacy', key: 'nav.privacy' },
];
---
<footer class="site-footer">
  <div class="wrap cols">
    <div>
      <p><strong lang="en" dir="ltr">Statecraft: Israel</strong></p>
      <p>{t(lang, 'footer.notaffiliated')}</p>
      <p>{t(lang, 'footer.licence')}</p>
      <p>{t(lang, 'footer.privacy')}</p>
    </div>
    <nav aria-label={t(lang, 'footer.more')}>
      <ul>{links.map((l) => <li><a href={href(lang, l.page)}>{t(lang, l.key)}</a></li>)}</ul>
    </nav>
    <div>
      <ul>
        {links2.map((l) => <li><a href={href(lang, l.page)}>{t(lang, l.key)}</a></li>)}
        <li><a href={REPO}>{t(lang, 'footer.repo')}</a></li>
        <li><a href={href(other, page)} lang={other} hreflang={other}>{t(lang, 'lang.other')}</a></li>
      </ul>
    </div>
  </div>
</footer>
