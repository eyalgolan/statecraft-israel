---
import { type Lang, type Page, href, otherLang, t } from '../i18n/ui';
interface Props { lang: Lang; page: Page }
const { lang, page } = Astro.props;
const main: { page: Page; key: Parameters<typeof t>[1] }[] = [
  { page: 'history', key: 'nav.history' },
  { page: 'cabinet', key: 'nav.cabinet' },
  { page: 'media', key: 'nav.media' },
  { page: 'devlog', key: 'nav.devlog' },
  { page: 'contributors', key: 'nav.contributors' },
  { page: 'how-we-make-it', key: 'nav.how' },
];
const more: { page: Page; key: Parameters<typeof t>[1] }[] = [
  { page: 'play', key: 'nav.play' },
  { page: 'history/sources', key: 'nav.sources' },
  { page: 'history/approach', key: 'nav.approach' },
  { page: 'press', key: 'nav.press' },
  { page: 'contribute', key: 'nav.contribute' },
  { page: 'privacy', key: 'nav.privacy' },
];
const current = (p: Page) => (p === page || (p === 'history' && page.startsWith('history/')) ? 'page' : undefined);
const other = otherLang(lang);
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={href(lang)} lang="en" dir="ltr">Statecraft<span>:</span> Israel</a>
    <nav class="nav" aria-label={t(lang, 'nav.label')}>
      {main.map((m) => <a href={href(lang, m.page)} aria-current={current(m.page)}>{t(lang, m.key)}</a>)}
    </nav>
    <details class="menu">
      <summary>{t(lang, 'nav.menu')}</summary>
      <nav class="menu-panel" aria-label={t(lang, 'nav.label')}>
        <a href={href(lang)} aria-current={current('')}>{t(lang, 'nav.home')}</a>
        {[...main, ...more].map((m) => <a href={href(lang, m.page)} aria-current={current(m.page)}>{t(lang, m.key)}</a>)}
        <a href={href(other, page)} lang={other} hreflang={other}>{t(lang, 'lang.other')}</a>
      </nav>
    </details>
    <div class="header-actions">
      <a class="lang-link" href={href(other, page)} lang={other} hreflang={other} aria-label={t(lang, 'lang.other.label')}>{t(lang, 'lang.other')}</a>
      <a class="btn btn-primary" href={href(lang, 'play')} aria-current={current('play')}>{t(lang, 'cta.play')}</a>
    </div>
  </div>
</header>
