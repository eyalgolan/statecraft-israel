---
// The visible label every image and video carries where it appears (both languages, never only in a footer).
import { type Lang, t } from '../i18n/ui';
import type { BuildInfo, Kind } from '../lib/media';
interface Props { lang: Lang; kind: Kind | 'archival'; build?: BuildInfo; gameplay?: boolean }
const { lang, kind, build, gameplay = false } = Astro.props;
const text = kind === 'engine' ? t(lang, gameplay ? 'label.gameplay' : 'label.engine')
  : kind === 'concept' ? t(lang, 'label.concept')
  : kind === 'cinematic' ? t(lang, 'label.cinematic')
  : t(lang, 'label.archival');
---
<span class={`label label-${kind}`} data-media-label={kind}><span>{text}{kind === 'engine' && build && <> — <bdi>{build.id[lang]}</bdi>{lang === 'he' ? ' · ' : ', '}<bdi>{build.date[lang]}</bdi></>}</span></span>
