{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GDD 0.3 event availability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ruleset",
    "exclusions"
  ],
  "properties": {
    "ruleset": {
      "type": "string",
      "enum": [
        "gdd-0.3"
      ]
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
