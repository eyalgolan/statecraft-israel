{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "content/events/*.yaml",
  "description": "One event per file. Field names follow the GameEvent type in sim/Statecraft.Sim/Content.cs; a test keeps them equal. See docs/WRITING_EVENTS.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "text", "from", "options", "sources"],
  "definitions": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "A day, YYYY-MM-DD." },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "Lowercase letters, digits and underscores, starting with a letter." }
  },
  "properties": {
    "id": { "$ref": "#/definitions/id", "description": "Unique across all events." },
    "title": { "type": "string", "minLength": 1, "description": "May contain office placeholders such as {prime_minister}." },
    "text": { "type": "string", "minLength": 1, "description": "May contain office placeholders. No invented quotes." },
    "tags": { "type": "array", "items": { "type": "string" }, "description": "holocaust, terror, massacre and war-casualties are sensitive." },
    "anchor": { "enum": ["hard", "soft"], "description": "Default soft. A hard anchor needs a historical option." },
    "office": { "$ref": "#/definitions/id", "description": "The office the event goes to when the player does not answer." },
    "from": { "$ref": "#/definitions/date", "description": "First day of the window." },
    "to": { "$ref": "#/definitions/date", "description": "End of the window (exclusive). Leave out for an open window." },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["indicator"],
        "properties": {
          "indicator": { "$ref": "#/definitions/id" },
          "min": { "type": "number" },
          "max": { "type": "number" }
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "option"],
      "properties": {
        "event": { "$ref": "#/definitions/id" },
        "option": { "$ref": "#/definitions/id" }
      }
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "text": { "type": "string", "minLength": 1 },
          "historical": { "type": "boolean" },
          "recommended": { "type": "boolean" },
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["target", "delta"],
              "properties": {
                "target": { "type": "string", "minLength": 1 },
                "delta": { "type": "number" }
              }
            }
          },
          "set_rung": { "type": "integer" },
          "set_policy": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }, "description": "Policy id to a level in [0, 1]." }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "checked"],
        "properties": {
          "url": { "type": "string", "pattern": "^https://", "description": "An https:// address (RealContentTests checks this)." },
          "checked": { "$ref": "#/definitions/date", "description": "The day you opened the source." }
        }
      }
    },
    "status": { "enum": ["draft", "fact-checked", "historian-reviewed", "sensitivity-reviewed"], "description": "The review status. Default draft." },
    "reviewed_by": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$", "description": "The GitHub handle of the person who signed this row off (#375): written only by that person, never by an AI agent (scripts/oss/reviewed_by_guard.py); never an email. Needs reviewed_on." },
    "reviewed_on": { "$ref": "#/definitions/date", "description": "The day of that sign-off. Needs reviewed_by." }
  }
}
