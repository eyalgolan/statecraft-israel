{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gameplay region geography",
  "description": "Geography and evidence only. Absence leaves regional initialization inactive. No start allocations or operational control are implied.",
  "type": "object",
  "additionalProperties": false,
  "required": ["player_regions"],
  "properties": {
    "player_regions": {
      "type": "array",
      "items": { "$ref": "#/$defs/region" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "hex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["q", "r"],
      "properties": {
        "q": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "r": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }
      }
    },
    "field_hex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["q", "r"],
      "dependentRequired": {
        "field": ["host", "host_basis", "host_source"],
        "host": ["field"],
        "host_basis": ["field"],
        "host_source": ["field"]
      },
      "properties": {
        "q": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "r": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "field": { "type": "string", "pattern": "^F[0-9]{2}$", "description": "This field's place in the file's order." },
        "host": { "$ref": "#/$defs/id", "description": "A census city of this region, or for F19 and F20 only a settlement of this region (R-POP-004)." },
        "host_basis": { "enum": ["sourced", "administrative", "forced", "inference", "design_choice", "decision_a"] },
        "host_source": { "type": "string", "minLength": 1 }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["SOURCED", "PARTIAL-EVIDENCE", "NEEDS-RESEARCH"] },
        "value": { "type": ["string", "null"] }
      },
      "if": { "properties": { "status": { "const": "SOURCED" } } },
      "then": { "required": ["value"], "properties": { "value": { "type": "string", "minLength": 1 } } },
      "else": { "properties": { "value": { "type": "null" } } }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capital_location", "member_hexes", "member_locations", "design_note", "sources", "capital_approval", "binding_status", "opening_control"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "capital_location": { "$ref": "#/$defs/id" },
        "member_hexes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/hex" } },
        "member_locations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" }, "description": "Each location's effective hex (after map overrides) must be one of this region's member_hexes, and a location may belong to at most one region." },
        "field_hexes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/field_hex" }, "description": "Optional opening field hexes (#1691 Q4), each one of this region's member_hexes, with an optional host (#1717). Data only." },
        "design_note": { "type": "string", "minLength": 1 },
        "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "capital_approval": { "enum": ["APPROVED", "NEEDS-RESEARCH"] },
        "binding_status": { "enum": ["SOURCED", "PARTIAL-EVIDENCE", "NEEDS-RESEARCH"] },
        "opening_control": { "$ref": "#/$defs/control" }
      }
    }
  }
}
