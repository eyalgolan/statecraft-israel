{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "content/parties.yaml",
  "description": "The parties. Field names follow the Party type in sim/Statecraft.Sim/Content.cs; a test keeps them equal.",
  "type": "object",
  "additionalProperties": false,
  "required": ["parties"],
  "properties": {
    "parties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "Lowercase letters, digits and underscores, starting with a letter. Unique." },
          "name": { "type": "string", "minLength": 1 },
          "name_he": { "type": "string", "minLength": 1, "description": "The Hebrew name (#558) as a source gives it. Leave out when no source gives one (the UI keeps the English). Needs name_he_sources." },
          "name_he_sources": { "$ref": "#/definitions/sources", "description": "Sources for name_he." }
        }
      }
    }
  },
  "definitions": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "A day, YYYY-MM-DD." },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "checked"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://", "description": "An https:// address." },
        "checked": { "$ref": "#/definitions/date", "description": "The day you opened the source." }
      }
    },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/source" } }
  }
}
